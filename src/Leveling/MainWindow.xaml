<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Multiverse.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Multiverse.MainWindow" mc:Ignorable="d" Title="Leveling">
    <Grid x:Name="RootLayout" Background="#F013171D" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="218"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ConnectionsColumn" Width="276"/>
        </Grid.ColumnDefinitions>
        <ui:CornerGlow Grid.RowSpan="2" Grid.ColumnSpan="3" Width="520" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        <ui:CornerGlow Grid.RowSpan="2" Grid.ColumnSpan="3" Width="420" Height="380" HorizontalAlignment="Left" VerticalAlignment="Bottom" BottomLeft="True"/>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="3" Background="#20141820">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleSidebarColumn" Width="218"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="248"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="10">
                    <Viewbox Width="30" Height="30" AutomationProperties.Name="Leveling"><Canvas Width="1000" Height="1000"><Path Fill="#E62D4F" Data="M500 388 372 246 258 82 280 334 310 384 100 284 180 450 188 634 336 782 336 712 258 624 248 450 370 564 384 402 500 524 616 402 630 564 752 450 742 624 664 712 664 782 812 634 820 450 900 284 690 384 720 334 742 82 628 246Z"/><Path Fill="#E62D4F" Data="M300 530 450 672 450 786 500 844 550 786 550 672 700 530 700 628 622 713 622 816 500 940 378 816 378 713 300 628Z"/></Canvas></Viewbox>
                    <TextBlock x:Name="SidebarAppName" Text="Leveling" FontSize="21" FontWeight="SemiBold" Foreground="#FFF4EF" VerticalAlignment="Center"/>
                </StackPanel>
                <Button ui:InterfaceMotion.Enabled="True" x:Name="CollapseSidebarButton" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="28" Height="30" Padding="0" Content="‹" Click="CollapseSidebarButton_Click" ToolTipService.ToolTip="Recolher ou expandir navegação"/>
                <Grid x:Name="ShellDragRegion" Grid.Column="1" Background="Transparent"/>
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#10171D" BorderBrush="#2A3545" BorderThickness="0" CornerRadius="14" Padding="11,5">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="#E62D4F" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShellStatusText" Text="Verificando" Foreground="#B9C2CF" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NavigationErrorText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Foreground="#FF8197" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="205" Visibility="Collapsed"/>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Grid.Column="0" Background="#70141820" BorderBrush="{StaticResource DesignGlassEdge}" BorderThickness="0" CornerRadius="8" Margin="8,4,4,8">
            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="SidebarComputerCard" Grid.Row="0" Background="{StaticResource DesignSurface}" BorderBrush="#303B45" BorderThickness="0" CornerRadius="12" Padding="12" Margin="0,10,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SidebarIcon Glyph="" Selected="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel x:Name="ComputerInfoPanel" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Este computador" Foreground="#8F9CA8" FontSize="11"/>
                            <TextBlock x:Name="SidebarLocalName" Text="Este PC" Foreground="#FFF4EF" FontWeight="SemiBold" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Ellipse x:Name="SidebarStatusDot" Width="9" Height="9" Fill="#8F9CA8"/>
                                <TextBlock x:Name="SidebarReadyText" Text="Verificando" FontSize="11" Foreground="#B9CDDC"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <StackPanel Spacing="5">
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavHome" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#33232B" BorderBrush="#E62D4F" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Computadores" Click="NavHome_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavHomeText" Grid.Column="1" Text="Computadores" Foreground="#FFFFFF" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavDevices" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Captura" Click="NavDevices_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavDevicesText" Grid.Column="1" Text="Captura" Foreground="#B9C2C9" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavFriends" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Amigos" Click="NavFriends_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavFriendsText" Grid.Column="1" Text="Amigos" Foreground="#B9C2C9" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavTransmission" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Transmissão" Click="NavTransmission_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavTransmissionText" Grid.Column="1" Text="Transmissão" Foreground="#B9C2C9" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavAudio" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Áudio" Click="NavAudio_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavAudioText" Grid.Column="1" Text="Áudio" Foreground="#B9C2C9" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavController" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Controle" Click="NavController_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavControllerText" Grid.Column="1" Text="Controle" Foreground="#B9C2C9" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavKeyboardMouse" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Teclado e mouse" Click="NavKeyboardMouse_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavKeyboardMouseText" Grid.Column="1" Text="Teclado e mouse" Foreground="#B9C2C9" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="NavSettings" Height="52" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="9" ToolTipService.ToolTip="Configurações" Click="NavSettings_Click" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SidebarIcon Glyph="" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSettingsText" Grid.Column="1" Text="Configurações" Foreground="#B9C2C9" FontSize="14" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="2" Background="{StaticResource DesignSurface}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="#E62D4F" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FooterStatusText" Text="Verificando" Foreground="#E62D4F" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Text="Leveling" Foreground="#6E7B8D" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1">
            <Border Background="Transparent" BorderBrush="{StaticResource DesignGlassEdge}" BorderThickness="0" CornerRadius="8" Margin="2,4,2,0">
                <Frame x:Name="ContentFrame" Background="{StaticResource DesignBackground}" Margin="0,20,0,0"/>
            </Border>
        </Grid>
        <Border x:Name="ConnectionsRail" Grid.Row="1" Grid.Column="2" Background="#70141820" BorderBrush="{StaticResource DesignAccentEdge}" BorderThickness="0" CornerRadius="8" Margin="4,4,8,8">
            <ui:StudioConnections x:Name="ConnectionsPanel"/>
        </Border>
        <InfoBar x:Name="UpdateNotice" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="24" IsOpen="False" IsClosable="True" Severity="Informational" Title="Nova atualização disponível!" Closed="UpdateNotice_Closed">
            <InfoBar.ActionButton><Button Content="Ver atualização" Click="OpenUpdate_Click"/></InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>