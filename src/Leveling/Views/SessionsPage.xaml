<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Multiverse.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Multiverse.Views.SessionsPage" Background="{StaticResource DesignBackground}" UseLayoutRounding="True">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DesignSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DesignGlassEdge}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="#1C252D"/>
            <Setter Property="Foreground" Value="#FFF4EF"/>
            <Setter Property="BorderBrush" Value="#303B45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,4,24,24" HorizontalAlignment="Stretch" Spacing="16">
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Text="Áudio" Foreground="#FFF4EF" FontSize="24" FontWeight="Bold" CharacterSpacing="0"/>
                    <TextBlock Text="Escolha exatamente qual aplicativo será transmitido. Microfone e outros programas ficam fora." Foreground="#8F9CA8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="15">
                        <StackPanel>
                            <TextBlock Text="FONTE NO HOST" Foreground="#FF9F43" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80"/>
                            <TextBlock Text="Aplicativo transmitido" Foreground="#FFF4EF" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                            <TextBlock Text="A captura por processo inclui apenas o aplicativo selecionado e sua árvore de processos." Foreground="#8F9CA8" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AudioProcessComboBox" MinWidth="0" PlaceholderText="Selecione um jogo ou aplicativo" SelectionChanged="AudioProcessComboBox_SelectionChanged"/>
                            <Button x:Name="RefreshAudioProcessesButton" Grid.Column="1" Content="Atualizar" Style="{StaticResource Ghost}" Click="RefreshAudioProcessesButton_Click"/>
                        </Grid>
                        <Button x:Name="ToggleRemoteAudioButton" Content="Transmitir áudio selecionado" Background="#FF9F43" Foreground="#1C252D" BorderThickness="0" CornerRadius="10" Padding="18,9" HorizontalAlignment="Left" Click="ToggleRemoteAudioButton_Click"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="15">
                        <StackPanel>
                            <TextBlock Text="SAÍDA NO CLIENTE" Foreground="#5DEBFF" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80"/>
                            <TextBlock Text="Onde o som será reproduzido" Foreground="#FFF4EF" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AudioOutputDeviceComboBox" MinWidth="0" PlaceholderText="Fone, caixa de som ou padrão do Windows" SelectionChanged="AudioOutputDeviceComboBox_SelectionChanged"/>
                            <Button x:Name="RefreshAudioOutputDevicesButton" Grid.Column="1" Content="Atualizar" Style="{StaticResource Ghost}" Click="RefreshAudioOutputDevicesButton_Click"/>
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Volume" Foreground="#B9C2C9" FontSize="11" VerticalAlignment="Center"/>
                            <Slider x:Name="RemoteAudioVolumeSlider" Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5" Value="100" ValueChanged="RemoteAudioVolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="RemoteAudioVolumeValueTextBlock" Grid.Column="2" Text="100%" Foreground="#FFC15A" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="100% é neutro. Acima disso, o cliente aplica boost digital com saturação para evitar overflow." Foreground="#8F9CA8" FontSize="9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Background="{StaticResource DesignField}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="21" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1">
                            <TextBlock Text="♪" Foreground="#E62D4F" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ESTADO DO CANAL" Foreground="#8F9CA8" FontSize="9"/>
                            <TextBlock x:Name="RemoteAudioStatusTextBlock" Text="Áudio parado" Foreground="#8F9CA8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="LEVELING AUDIO • canal de áudio separado do vídeo e do controle." Foreground="#8F9CA8" FontSize="9" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>