<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Multiverse.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tips="using:Multiverse.Services" x:Class="Multiverse.Views.SettingsPage" xmlns:updates="using:Multiverse.Views" UseLayoutRounding="True">
    <Page.Resources>
        <SolidColorBrush x:Key="Bg" Color="#10171D"/>
        <SolidColorBrush x:Key="Border" Color="#303B45"/>
        <SolidColorBrush x:Key="Accent" Color="#E62D4F"/>
        <SolidColorBrush x:Key="Text" Color="#FFF4EF"/>
        <SolidColorBrush x:Key="Muted" Color="#B0BBC5"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FFF4EF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
    </Page.Resources>
    <Grid Background="{StaticResource DesignBackground}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsResponsiveStates">
                <VisualState x:Name="SettingsWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="24,4,24,24"/>
                        <Setter Target="SettingsTopCol0.Width" Value="*"/>
                        <Setter Target="SettingsTopCol1.Width" Value="*"/>
                        <Setter Target="SettingsTopRow1.Height" Value="0"/>
                        <Setter Target="BehaviorCard.(Grid.Row)" Value="0"/>
                        <Setter Target="BehaviorCard.(Grid.Column)" Value="1"/>
                        <Setter Target="BehaviorCard.Margin" Value="0"/>
                        <Setter Target="ResetPreferencesButton.(Grid.Row)" Value="0"/>
                        <Setter Target="ResetPreferencesButton.(Grid.Column)" Value="1"/>
                        <Setter Target="ResetPreferencesButton.Margin" Value="0"/>
                        <Setter Target="ToolsButtons.(Grid.Row)" Value="0"/>
                        <Setter Target="ToolsButtons.(Grid.Column)" Value="1"/>
                        <Setter Target="ToolsButtons.Margin" Value="0"/>
                        <Setter Target="SaveButtonResponsive.(Grid.Row)" Value="0"/>
                        <Setter Target="SaveButtonResponsive.(Grid.Column)" Value="1"/>
                        <Setter Target="SaveButtonResponsive.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SettingsCompact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsContent.Padding" Value="24,4,24,24"/>
                        <Setter Target="SettingsTopCol0.Width" Value="*"/>
                        <Setter Target="SettingsTopCol1.Width" Value="0"/>
                        <Setter Target="SettingsTopRow1.Height" Value="Auto"/>
                        <Setter Target="BehaviorCard.(Grid.Row)" Value="1"/>
                        <Setter Target="BehaviorCard.(Grid.Column)" Value="0"/>
                        <Setter Target="BehaviorCard.Margin" Value="0,14,0,0"/>
                        <Setter Target="ResetPreferencesButton.(Grid.Row)" Value="1"/>
                        <Setter Target="ResetPreferencesButton.(Grid.Column)" Value="0"/>
                        <Setter Target="ResetPreferencesButton.Margin" Value="0,12,0,0"/>
                        <Setter Target="ToolsButtons.(Grid.Row)" Value="1"/>
                        <Setter Target="ToolsButtons.(Grid.Column)" Value="0"/>
                        <Setter Target="ToolsButtons.Margin" Value="0,12,0,0"/>
                        <Setter Target="SaveButtonResponsive.(Grid.Row)" Value="1"/>
                        <Setter Target="SaveButtonResponsive.(Grid.Column)" Value="0"/>
                        <Setter Target="SaveButtonResponsive.Margin" Value="0,12,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsContent" Padding="24,4,24,24" Spacing="16">
                <Border Background="Transparent" MinHeight="72">
                    <Grid Background="Transparent" Padding="0,8,0,12">
                        <StackPanel Spacing="7" VerticalAlignment="Center" MaxWidth="460" HorizontalAlignment="Left">
                            <TextBlock Text="Configurações" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable Display" TextWrapping="Wrap"/>
                            <TextBlock Text="Deixe o Leveling do seu jeito." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid ColumnSpacing="16" RowSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SettingsTopCol0" Width="*"/>
                        <ColumnDefinition x:Name="SettingsTopCol1" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="SettingsTopRow1" Height="0"/>
                    </Grid.RowDefinitions>
                    <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Background="{StaticResource DesignSurface}" BorderBrush="{StaticResource DesignGlassEdge}" BorderThickness="0" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DesignIconTile}">
                                    <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource DesignAccent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="TRANSMISSÃO" Style="{StaticResource DesignKicker}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Perfil padrão" Style="{StaticResource DesignSectionTitle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Usado na próxima transmissão." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FPS" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ComboBox x:Name="FpsComboBox" tips:LevelingInfoToolTip.Text="Define quantos quadros por segundo o Leveling tenta transmitir. 60 FPS deixa o movimento mais fluido, mas exige mais da captura, encoder e conexão." Grid.Column="1">
                                    <ComboBoxItem Content="30 FPS" Tag="30"/>
                                    <ComboBoxItem Content="60 FPS" Tag="60"/>
<ComboBoxItem Content="80 FPS" Tag="80"/>
<ComboBoxItem Content="90 FPS" Tag="90"/>
<ComboBoxItem Content="120 FPS" Tag="120"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bitrate" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ComboBox x:Name="BitrateComboBox" tips:LevelingInfoToolTip.Text="Define a quantidade de dados usada pelo vídeo. Valores maiores melhoram a qualidade, mas exigem mais upload, download e estabilidade da conexão." Grid.Column="1">
                                    <ComboBoxItem Content="5 Mbps" Tag="5000"/>
                                    <ComboBoxItem Content="10 Mbps" Tag="10000"/>
                                    <ComboBoxItem Content="15 Mbps" Tag="15000"/>
                                    <ComboBoxItem Content="20 Mbps" Tag="20000"/>
                                    <ComboBoxItem Content="30 Mbps" Tag="30000"/>
                                    <ComboBoxItem Content="35 Mbps" Tag="35000"/>
                                    <ComboBoxItem Content="40 Mbps" Tag="40000"/>
                                    <ComboBoxItem Content="50 Mbps" Tag="50000"/>
                                    <ComboBoxItem Content="75 Mbps" Tag="75000"/>
                                    <ComboBoxItem Content="100 Mbps" Tag="100000"/>
                                    <ComboBoxItem Content="150 Mbps" Tag="150000"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NVENC" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ComboBox x:Name="PresetComboBox" tips:LevelingInfoToolTip.Text="Controla o equilíbrio do NVENC entre desempenho e qualidade. P1 é mais leve; P3/P4 podem melhorar a imagem, mas aumentam o trabalho da GPU." Grid.Column="1">
                                    <ComboBoxItem Content="Automático" Tag="0"/>
                                    <ComboBoxItem Content="P1 • mais leve" Tag="1"/>
                                    <ComboBoxItem Content="P2 • equilibrado" Tag="2"/>
                                    <ComboBoxItem Content="P3 • mais qualidade" Tag="3"/>
                                    <ComboBoxItem Content="P4 • máxima qualidade" Tag="4"/>
                                </ComboBox>
                            </Grid>
                            <ToggleSwitch x:Name="UltraLowLatencyToggle" tips:LevelingInfoToolTip.Text="Prioriza o menor atraso possível no encoder. É o modo recomendado para jogos remotos e evita acumular frames antes do envio." Header="Baixa latência do encoder" OnContent="Ativa" OffContent="Desativada"/>
                            <Border Background="{StaticResource DesignSurface}" BorderBrush="#721B32" BorderThickness="0" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                                <Grid ColumnSpacing="16" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="SaveStatusText" TextWrapping="Wrap" Text="Nenhuma alteração salva nesta sessão." Foreground="{StaticResource Muted}"/>
                                        <TextBlock Text="Aplicado à próxima transmissão." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                    <Button ui:InterfaceMotion.Enabled="True" x:Name="SaveButtonResponsive" Grid.Column="1" Content="Salvar alterações" Click="SaveButton_Click" Style="{StaticResource DesignAction}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
</Grid>
                    <Border x:Name="BehaviorCard" Grid.Column="1" Background="{StaticResource DesignSurface}" BorderBrush="{StaticResource DesignGlassEdge}" BorderThickness="0" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DesignIconTile}">
                                    <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource DesignAccent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="COMPORTAMENTO" Style="{StaticResource DesignKicker}" TextWrapping="Wrap"/>
                                    <TextBlock Text="Sessão e interface" Style="{StaticResource DesignSectionTitle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <Grid MinHeight="46" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Abrir a janela remota automaticamente no cliente" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Abre a imagem ao conectar." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="AutoOpenClientWindowToggle" tips:LevelingInfoToolTip.Text="Abre automaticamente a janela que mostra o PC remoto assim que o cliente entra em uma sessão válida." OnContent="Sim" OffContent="Não"/>
                            </Grid>
                            <Grid MinHeight="46" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Iniciar transmissão quando um cliente conectar" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Inicia após uma conexão autorizada." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="AutoStartHostStreamToggle" tips:LevelingInfoToolTip.Text="Faz o host começar a transmitir automaticamente quando um cliente se conecta, sem precisar apertar Transmitir agora." OnContent="Sim" OffContent="Não"/>
                            </Grid>
                            <Grid MinHeight="46" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Reduzir movimento e efeitos da interface" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Desativa transições e efeitos." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="LowMotionToggle" tips:LevelingInfoToolTip.Text="Reduz animações e efeitos visuais do próprio Leveling. Não muda a qualidade do stream e pode deixar a interface ainda mais leve." OnContent="Reduzir movimento" OffContent="Efeitos curtos"/>
                            </Grid>
                            <Grid MinHeight="46" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar HUD no cliente" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Estatísticas na tela remota." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="TransmissionHudToggle" tips:LevelingInfoToolTip.Text="Mostra no cliente um HUD local com métricas da sessão. Ele não altera o vídeo recebido e pode ser ocultado a qualquer momento." OnContent="Visível" OffContent="Oculto" Toggled="TransmissionHudToggle_Toggled"/>
                            </Grid>
                            <Grid MinHeight="46" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Mostrar HUD no host durante a transmissão" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Estatísticas neste PC." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="HostTransmissionHudToggle" tips:LevelingInfoToolTip.Text="Mostra no monitor do host as métricas da transmissão. O overlay é excluído da captura para não aparecer no vídeo enviado ao cliente." OnContent="Visível" OffContent="Oculto" Toggled="HostTransmissionHudToggle_Toggled"/>
                            </Grid>
                            <Grid MinHeight="46" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Minimizar para a bandeja ao fechar" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Continua aberto na bandeja." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="MinimizeToTrayToggle" tips:LevelingInfoToolTip.Text="Ao fechar a janela principal, mantém o Leveling rodando na bandeja em vez de encerrar completamente o aplicativo." OnContent="Bandeja" OffContent="Encerrar" Toggled="MinimizeToTrayToggle_Toggled"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Diagnóstico" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <ComboBox x:Name="DiagnosticsLevelComboBox" tips:LevelingInfoToolTip.Text="Escolhe quanto diagnóstico o Leveling coleta e exibe. Avançado mostra mais detalhes do pipeline; Básico é suficiente para uso normal." Grid.Column="1">
                                    <ComboBoxItem Content="Desativado" Tag="Off"/>
                                    <ComboBoxItem Content="Básico" Tag="Basic"/>
                                    <ComboBoxItem Content="Avançado" Tag="Advanced"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Background="{StaticResource DesignSurface}" BorderBrush="{StaticResource DesignGlassEdge}" BorderThickness="0" CornerRadius="12" Padding="20">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="7">
                            <TextBlock Text="ÁUDIO DO CLIENTE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AudioPreferenceText" Text="Padrão do Windows • 100%" Foreground="{StaticResource Text}" FontSize="17" TextWrapping="Wrap"/>
                            <TextBlock Text="Ajuste saída e volume em Áudio." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="ResetPreferencesButton" Grid.Column="1" Content="Restaurar preferências" Click="ResetButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
</Grid>
                <Border Background="{StaticResource DesignSurface}" BorderBrush="{StaticResource DesignGlassEdge}" BorderThickness="0" CornerRadius="12" Padding="20">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="7">
                            <TextBlock Text="FERRAMENTAS" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Acesso rápido" Foreground="{StaticResource Text}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="ToolsButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button ui:InterfaceMotion.Enabled="True" Content="Áudio" Click="OpenAudioButton_Click"/>
                            <Button ui:InterfaceMotion.Enabled="True" Content="Controle" Click="OpenControllerButton_Click"/>
                            <Button ui:InterfaceMotion.Enabled="True" Content="Diagnóstico" Click="OpenDiagnosticsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{StaticResource DesignSurface}" CornerRadius="12" Padding="20"><updates:UpdatePanel/></Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>