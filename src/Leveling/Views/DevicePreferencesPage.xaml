<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Multiverse.Services" x:Class="Multiverse.Views.DevicePreferencesPage" Background="{StaticResource DesignBackground}" UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,4,24,24" Spacing="16">
            <Border Background="Transparent" CornerRadius="0" MinHeight="72" BorderBrush="Transparent" BorderThickness="0">
                <Grid Background="Transparent" Padding="0,8,0,12">
                    <StackPanel Spacing="5" VerticalAlignment="Center" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="Captura" Style="{StaticResource DesignTitle}" FontFamily="Segoe UI Variable Display" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="Escolha a tela do jogo." Style="{StaticResource DesignSubtitle}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Style="{StaticResource DesignCard}">
                <Grid ColumnSpacing="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DesignIconTile}">
                                <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource DesignAccent}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="MONITOR DO HOST" Style="{StaticResource DesignKicker}"/>
                                <TextBlock Text="Tela transmitida" Style="{StaticResource DesignSectionTitle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Escolha o monitor e salve para a próxima sessão." Style="{StaticResource DesignSubtitle}"/>
                        <ComboBox Header="Monitor" x:Name="MonitorComboBox" PlaceholderText="Carregando monitores…" SelectionChanged="MonitorComboBox_SelectionChanged"/>
                        <TextBlock x:Name="MonitorDetailText" Style="{StaticResource DesignSubtitle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button ui:InterfaceMotion.Enabled="True" Content="↻  Atualizar" Click="RefreshButton_Click"/>
                            <Button ui:InterfaceMotion.Enabled="True" x:Name="SaveButton" Content="Salvar monitor" Style="{StaticResource DesignAction}" Click="SaveButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
</Grid>
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Style="{StaticResource DesignCard}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DesignIconTile}">
                                <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource DesignAccent}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="GPU / CORE" Style="{StaticResource DesignKicker}"/>
                                <TextBlock Text="Hardware de captura" Style="{StaticResource DesignSectionTitle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CoreStatusText" Style="{StaticResource DesignSectionTitle}"/>
                        <TextBlock x:Name="GpuSummaryText" Style="{StaticResource DesignSubtitle}"/>
                    </StackPanel>
                </Border>
</Grid>
                <Border Grid.Column="1" Style="{StaticResource DesignCard}">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DesignIconTile}">
                                <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource DesignAccent}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <TextBlock Text="PERFIL" Style="{StaticResource DesignKicker}"/>
                                <TextBlock Text="Qualidade configurada" Style="{StaticResource DesignSectionTitle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ProfileSummaryText" Style="{StaticResource DesignSectionTitle}"/>
                        <TextBlock Text="FPS e bitrate são usados na próxima transmissão." Style="{StaticResource DesignSubtitle}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource DesignCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="ⓘ  Informação" Style="{StaticResource DesignSectionTitle}"/>
                    <TextBlock x:Name="StatusText" Text="Selecione o monitor e clique em Salvar monitor." Style="{StaticResource DesignSubtitle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>