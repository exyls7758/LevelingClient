<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tips="using:Multiverse.Services" x:Class="Multiverse.Views.DevicesPage" Background="{StaticResource DesignBackground}" UseLayoutRounding="True">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DeviceLayoutStates">
                <!-- Desktop / large window -->
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PagePadding.Padding" Value="28"/>
                        <Setter Target="RefreshButton.(Grid.Row)" Value="0"/>
                        <Setter Target="RefreshButton.(Grid.Column)" Value="1"/>
                        <Setter Target="RefreshButton.HorizontalAlignment" Value="Right"/>
                        <Setter Target="RefreshButton.Margin" Value="18,0,0,0"/>
                        <Setter Target="CoreStatusPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="CoreStatusPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="CoreStatusPanel.HorizontalAlignment" Value="Right"/>
                        <Setter Target="CoreStatusPanel.Margin" Value="18,0,0,0"/>
                        <Setter Target="CaptureHeaderButtons.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureHeaderButtons.(Grid.Column)" Value="1"/>
                        <Setter Target="CaptureHeaderButtons.HorizontalAlignment" Value="Right"/>
                        <Setter Target="CaptureHeaderButtons.Margin" Value="18,0,0,0"/>
                        <Setter Target="CaptureStatsCol0.Width" Value="*"/>
                        <Setter Target="CaptureStatsCol1.Width" Value="*"/>
                        <Setter Target="CaptureStatsCol2.Width" Value="*"/>
                        <Setter Target="CaptureStatsCol3.Width" Value="*"/>
                        <Setter Target="CaptureStatsRow1.Height" Value="0"/>
                        <Setter Target="CaptureStatSource.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureStatSource.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureStatGpu.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureStatGpu.(Grid.Column)" Value="1"/>
                        <Setter Target="CaptureStatPreview.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureStatPreview.(Grid.Column)" Value="2"/>
                        <Setter Target="CaptureStatFrame.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureStatFrame.(Grid.Column)" Value="3"/>
                        <Setter Target="PreviewBorder.MinHeight" Value="300"/>
                        <Setter Target="EncoderHeaderButtons.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderHeaderButtons.(Grid.Column)" Value="1"/>
                        <Setter Target="EncoderHeaderButtons.HorizontalAlignment" Value="Right"/>
                        <Setter Target="EncoderHeaderButtons.Margin" Value="18,0,0,0"/>
                        <Setter Target="EncoderOptionCol0.Width" Value="*"/>
                        <Setter Target="EncoderOptionCol1.Width" Value="*"/>
                        <Setter Target="EncoderOptionCol2.Width" Value="*"/>
                        <Setter Target="EncoderOptionCol3.Width" Value="*"/>
                        <Setter Target="EncoderOptionRow1.Height" Value="0"/>
                        <Setter Target="EncoderOptionFps.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderOptionFps.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderOptionBitrate.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderOptionBitrate.(Grid.Column)" Value="1"/>
                        <Setter Target="EncoderOptionPreset.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderOptionPreset.(Grid.Column)" Value="2"/>
                        <Setter Target="EncoderOptionTuning.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderOptionTuning.(Grid.Column)" Value="3"/>
                        <Setter Target="EncoderMetricCol0.Width" Value="*"/>
                        <Setter Target="EncoderMetricCol1.Width" Value="*"/>
                        <Setter Target="EncoderMetricCol2.Width" Value="*"/>
                        <Setter Target="EncoderMetricCol3.Width" Value="*"/>
                        <Setter Target="EncoderMetricCol4.Width" Value="*"/>
                        <Setter Target="EncoderMetricRow1.Height" Value="0"/>
                        <Setter Target="EncoderMetricRow2.Height" Value="0"/>
                        <Setter Target="EncoderMetricRow3.Height" Value="0"/>
                        <Setter Target="EncoderMetricRow4.Height" Value="0"/>
                        <Setter Target="MetricFps.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricFps.(Grid.Column)" Value="0"/>
                        <Setter Target="MetricBitrate.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricBitrate.(Grid.Column)" Value="1"/>
                        <Setter Target="MetricLatency.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricLatency.(Grid.Column)" Value="2"/>
                        <Setter Target="MetricSubmit.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricSubmit.(Grid.Column)" Value="3"/>
                        <Setter Target="MetricQueue.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricQueue.(Grid.Column)" Value="4"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- Medium window: 2-column cards/options -->
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PagePadding.Padding" Value="20"/>
                        <Setter Target="RefreshButton.(Grid.Row)" Value="0"/>
                        <Setter Target="RefreshButton.(Grid.Column)" Value="1"/>
                        <Setter Target="RefreshButton.HorizontalAlignment" Value="Right"/>
                        <Setter Target="RefreshButton.Margin" Value="14,0,0,0"/>
                        <Setter Target="CoreStatusPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="CoreStatusPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="CoreStatusPanel.HorizontalAlignment" Value="Right"/>
                        <Setter Target="CoreStatusPanel.Margin" Value="12,0,0,0"/>
                        <Setter Target="CaptureHeaderButtons.(Grid.Row)" Value="1"/>
                        <Setter Target="CaptureHeaderButtons.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureHeaderButtons.HorizontalAlignment" Value="Left"/>
                        <Setter Target="CaptureHeaderButtons.Margin" Value="0,12,0,0"/>
                        <Setter Target="CaptureStatsCol0.Width" Value="*"/>
                        <Setter Target="CaptureStatsCol1.Width" Value="*"/>
                        <Setter Target="CaptureStatsCol2.Width" Value="0"/>
                        <Setter Target="CaptureStatsCol3.Width" Value="0"/>
                        <Setter Target="CaptureStatsRow1.Height" Value="Auto"/>
                        <Setter Target="CaptureStatSource.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureStatSource.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureStatGpu.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureStatGpu.(Grid.Column)" Value="1"/>
                        <Setter Target="CaptureStatPreview.(Grid.Row)" Value="1"/>
                        <Setter Target="CaptureStatPreview.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureStatFrame.(Grid.Row)" Value="1"/>
                        <Setter Target="CaptureStatFrame.(Grid.Column)" Value="1"/>
                        <Setter Target="PreviewBorder.MinHeight" Value="230"/>
                        <Setter Target="EncoderHeaderButtons.(Grid.Row)" Value="1"/>
                        <Setter Target="EncoderHeaderButtons.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderHeaderButtons.HorizontalAlignment" Value="Left"/>
                        <Setter Target="EncoderHeaderButtons.Margin" Value="0,12,0,0"/>
                        <Setter Target="EncoderOptionCol0.Width" Value="*"/>
                        <Setter Target="EncoderOptionCol1.Width" Value="*"/>
                        <Setter Target="EncoderOptionCol2.Width" Value="0"/>
                        <Setter Target="EncoderOptionCol3.Width" Value="0"/>
                        <Setter Target="EncoderOptionRow1.Height" Value="Auto"/>
                        <Setter Target="EncoderOptionFps.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderOptionFps.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderOptionBitrate.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderOptionBitrate.(Grid.Column)" Value="1"/>
                        <Setter Target="EncoderOptionPreset.(Grid.Row)" Value="1"/>
                        <Setter Target="EncoderOptionPreset.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderOptionTuning.(Grid.Row)" Value="1"/>
                        <Setter Target="EncoderOptionTuning.(Grid.Column)" Value="1"/>
                        <Setter Target="EncoderMetricCol0.Width" Value="*"/>
                        <Setter Target="EncoderMetricCol1.Width" Value="*"/>
                        <Setter Target="EncoderMetricCol2.Width" Value="0"/>
                        <Setter Target="EncoderMetricCol3.Width" Value="0"/>
                        <Setter Target="EncoderMetricCol4.Width" Value="0"/>
                        <Setter Target="EncoderMetricRow1.Height" Value="Auto"/>
                        <Setter Target="EncoderMetricRow2.Height" Value="Auto"/>
                        <Setter Target="EncoderMetricRow3.Height" Value="0"/>
                        <Setter Target="EncoderMetricRow4.Height" Value="0"/>
                        <Setter Target="MetricFps.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricFps.(Grid.Column)" Value="0"/>
                        <Setter Target="MetricBitrate.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricBitrate.(Grid.Column)" Value="1"/>
                        <Setter Target="MetricLatency.(Grid.Row)" Value="1"/>
                        <Setter Target="MetricLatency.(Grid.Column)" Value="0"/>
                        <Setter Target="MetricSubmit.(Grid.Row)" Value="1"/>
                        <Setter Target="MetricSubmit.(Grid.Column)" Value="1"/>
                        <Setter Target="MetricQueue.(Grid.Row)" Value="2"/>
                        <Setter Target="MetricQueue.(Grid.Column)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- Small window: everything stacks vertically -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PagePadding.Padding" Value="12"/>
                        <Setter Target="RefreshButton.(Grid.Row)" Value="1"/>
                        <Setter Target="RefreshButton.(Grid.Column)" Value="0"/>
                        <Setter Target="RefreshButton.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="RefreshButton.Margin" Value="0,12,0,0"/>
                        <Setter Target="CoreStatusPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="CoreStatusPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="CoreStatusPanel.HorizontalAlignment" Value="Left"/>
                        <Setter Target="CoreStatusPanel.Margin" Value="0,12,0,0"/>
                        <Setter Target="CaptureHeaderButtons.(Grid.Row)" Value="1"/>
                        <Setter Target="CaptureHeaderButtons.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureHeaderButtons.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="CaptureHeaderButtons.Margin" Value="0,12,0,0"/>
                        <Setter Target="MonitorComboBox.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="CaptureStatsCol0.Width" Value="*"/>
                        <Setter Target="CaptureStatsCol1.Width" Value="0"/>
                        <Setter Target="CaptureStatsCol2.Width" Value="0"/>
                        <Setter Target="CaptureStatsCol3.Width" Value="0"/>
                        <Setter Target="CaptureStatsRow1.Height" Value="Auto"/>
                        <Setter Target="CaptureStatsRow2.Height" Value="Auto"/>
                        <Setter Target="CaptureStatsRow3.Height" Value="Auto"/>
                        <Setter Target="CaptureStatSource.(Grid.Row)" Value="0"/>
                        <Setter Target="CaptureStatSource.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureStatGpu.(Grid.Row)" Value="1"/>
                        <Setter Target="CaptureStatGpu.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureStatPreview.(Grid.Row)" Value="2"/>
                        <Setter Target="CaptureStatPreview.(Grid.Column)" Value="0"/>
                        <Setter Target="CaptureStatFrame.(Grid.Row)" Value="3"/>
                        <Setter Target="CaptureStatFrame.(Grid.Column)" Value="0"/>
                        <Setter Target="PreviewBorder.MinHeight" Value="170"/>
                        <Setter Target="EncoderHeaderButtons.(Grid.Row)" Value="1"/>
                        <Setter Target="EncoderHeaderButtons.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderHeaderButtons.HorizontalAlignment" Value="Stretch"/>
                        <Setter Target="EncoderHeaderButtons.Margin" Value="0,12,0,0"/>
                        <Setter Target="EncoderOptionCol0.Width" Value="*"/>
                        <Setter Target="EncoderOptionCol1.Width" Value="0"/>
                        <Setter Target="EncoderOptionCol2.Width" Value="0"/>
                        <Setter Target="EncoderOptionCol3.Width" Value="0"/>
                        <Setter Target="EncoderOptionRow1.Height" Value="Auto"/>
                        <Setter Target="EncoderOptionRow2.Height" Value="Auto"/>
                        <Setter Target="EncoderOptionRow3.Height" Value="Auto"/>
                        <Setter Target="EncoderOptionFps.(Grid.Row)" Value="0"/>
                        <Setter Target="EncoderOptionFps.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderOptionBitrate.(Grid.Row)" Value="1"/>
                        <Setter Target="EncoderOptionBitrate.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderOptionPreset.(Grid.Row)" Value="2"/>
                        <Setter Target="EncoderOptionPreset.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderOptionTuning.(Grid.Row)" Value="3"/>
                        <Setter Target="EncoderOptionTuning.(Grid.Column)" Value="0"/>
                        <Setter Target="EncoderMetricCol0.Width" Value="*"/>
                        <Setter Target="EncoderMetricCol1.Width" Value="0"/>
                        <Setter Target="EncoderMetricCol2.Width" Value="0"/>
                        <Setter Target="EncoderMetricCol3.Width" Value="0"/>
                        <Setter Target="EncoderMetricCol4.Width" Value="0"/>
                        <Setter Target="EncoderMetricRow1.Height" Value="Auto"/>
                        <Setter Target="EncoderMetricRow2.Height" Value="Auto"/>
                        <Setter Target="EncoderMetricRow3.Height" Value="Auto"/>
                        <Setter Target="EncoderMetricRow4.Height" Value="Auto"/>
                        <Setter Target="MetricFps.(Grid.Row)" Value="0"/>
                        <Setter Target="MetricFps.(Grid.Column)" Value="0"/>
                        <Setter Target="MetricBitrate.(Grid.Row)" Value="1"/>
                        <Setter Target="MetricBitrate.(Grid.Column)" Value="0"/>
                        <Setter Target="MetricLatency.(Grid.Row)" Value="2"/>
                        <Setter Target="MetricLatency.(Grid.Column)" Value="0"/>
                        <Setter Target="MetricSubmit.(Grid.Row)" Value="3"/>
                        <Setter Target="MetricSubmit.(Grid.Column)" Value="0"/>
                        <Setter Target="MetricQueue.(Grid.Row)" Value="4"/>
                        <Setter Target="MetricQueue.(Grid.Column)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="PagePadding" Padding="28">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- HEADER -->
                    <Grid Margin="0,0,0,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TRANSMISSÃO" Foreground="#FFF4EF" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Vídeo remoto • 30–120 FPS • o núcleo de streaming permanece protegido. Áudio e controle agora têm páginas próprias." Foreground="#8F9CA8" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Atualizar" Padding="18,8" Background="#1C252D" Foreground="#B9C2C9" BorderBrush="#303B45" BorderThickness="1" CornerRadius="8" Click="RefreshButton_Click"/>
                    </Grid>
                    <!-- CORE -->
                    <Border Grid.Row="1" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="NÚCLEO NATIVO" Foreground="#8F9CA8" FontSize="9"/>
                                <TextBlock x:Name="CoreStatusTitle" Text="Verificando..." Foreground="#FFF4EF" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="CoreStatusDescription" Text="Aguardando Leveling Core." Foreground="#8F9CA8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="CoreStatusPanel" Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <Ellipse x:Name="CoreStatusDot" Width="7" Height="7" Fill="#8F9CA8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CoreStatusBadge" Text="Verificando" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- GPU -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,18">
                        <TextBlock Text="GPU" Foreground="#FFF4EF" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,10"/>
                        <StackPanel x:Name="GpuListPanel" Spacing="9"/>
                    </StackPanel>
                    <!-- MONITORS -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,18">
                        <TextBlock Text="MONITORES" Foreground="#FFF4EF" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,10"/>
                        <StackPanel x:Name="MonitorListPanel" Spacing="9"/>
                    </StackPanel>
                    <!-- CAPTURE -->
                    <Border Grid.Row="4" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CAPTURA / PREVIEW" Foreground="#8F9CA8" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="Desktop Duplication" Foreground="#FFF4EF" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="Durante o encode, o preview diagnóstico cai para ~5 FPS para não competir com a transmissão." Foreground="#8F9CA8" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="CaptureHeaderButtons" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="9">
                                    <Button x:Name="StartPreviewButton" Content="Iniciar preview" Padding="17,8" Background="#E62D4F" Foreground="#1C252D" BorderThickness="0" CornerRadius="8" Click="StartPreviewButton_Click"/>
                                    <Button x:Name="StopPreviewButton" Content="Parar" Padding="17,8" Background="#1C252D" Foreground="#BEBEBE" BorderBrush="#303B45" BorderThickness="1" CornerRadius="8" IsEnabled="False" Click="StopPreviewButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <ComboBox x:Name="MonitorComboBox" tips:LevelingInfoToolTip.Text="Escolhe qual monitor do host será usado como fonte de captura para preview e transmissão." HorizontalAlignment="Stretch" MaxWidth="520" Background="#1C252D"/>
                            <Grid ColumnSpacing="9" RowSpacing="9">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition x:Name="CaptureStatsRow1" Height="0"/>
                                    <RowDefinition x:Name="CaptureStatsRow2" Height="0"/>
                                    <RowDefinition x:Name="CaptureStatsRow3" Height="0"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CaptureStatsCol0" Width="*"/>
                                    <ColumnDefinition x:Name="CaptureStatsCol1" Width="*"/>
                                    <ColumnDefinition x:Name="CaptureStatsCol2" Width="*"/>
                                    <ColumnDefinition x:Name="CaptureStatsCol3" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CaptureStatSource" Grid.Column="0" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="FONTE" Foreground="#8F9CA8" FontSize="8"/>
                                        <TextBlock x:Name="SourceResolutionTextBlock" Text="-- × --" Foreground="#FFF4EF" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="CaptureStatGpu" Grid.Column="1" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="DESKTOP UPDATE" Foreground="#8F9CA8" FontSize="8" ToolTipService.ToolTip="Frames em que a imagem do desktop realmente mudou. Atualizações exclusivas do cursor são enviadas separadamente. Esta taxa mede atividade do desktop, não o FPS alvo do stream."/>
                                        <TextBlock x:Name="CaptureFpsTextBlock" Text="-- FPS" Foreground="#E62D4F" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="CaptureStatPreview" Grid.Column="2" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="PREVIEW UI" Foreground="#8F9CA8" FontSize="8"/>
                                        <TextBlock x:Name="PreviewFpsTextBlock" Text="-- FPS" Foreground="#FFF4EF" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="CaptureStatFrame" Grid.Column="3" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="9" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="FRAME" Foreground="#8F9CA8" FontSize="8"/>
                                        <TextBlock x:Name="FrameIdTextBlock" Text="#0" Foreground="#FFF4EF" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="CapturePipelineTelemetryTextBlock" Text="CAPTURE PIPELINE  •  aguardando dados" Foreground="#8F9CA8" FontSize="9" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CapturePipelineDetailTextBlock" Text="CAPTURE DETAIL  •  aguardando dados" Foreground="#626262" FontSize="9" TextWrapping="Wrap"/>
                            <Border x:Name="PreviewBorder" Background="{StaticResource DesignField}" BorderBrush="#303B45" BorderThickness="1" CornerRadius="11" MinHeight="300" MaxHeight="540">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                    <StackPanel x:Name="PreviewPlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                        <TextBlock Text="Inicie o preview para testar a captura." Foreground="#696969" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- ENCODER -->
                    <Border Grid.Row="5" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ENCODER H.264" Foreground="#8F9CA8" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="NVIDIA NVENC • pipeline assíncrono" Foreground="#FFF4EF" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="NvencSupportTextBlock" Text="Verificando suporte..." Foreground="#8F9CA8" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="EncoderHeaderButtons" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="StartEncoderButton" Content="Iniciar encoder" IsEnabled="False" Padding="17,8" Background="#E62D4F" Foreground="#1C252D" BorderThickness="0" CornerRadius="8" Click="StartEncoderButton_Click"/>
                                    <Button x:Name="ForceIdrButton" Content="Forçar IDR" IsEnabled="False" Padding="14,8" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="8" Click="ForceIdrButton_Click"/>
                                    <Button x:Name="StopEncoderButton" Content="Parar" IsEnabled="False" Padding="14,8" Background="#1C252D" BorderBrush="#303B45" BorderThickness="1" CornerRadius="8" Click="StopEncoderButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="10" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition x:Name="EncoderOptionRow1" Height="0"/>
                                    <RowDefinition x:Name="EncoderOptionRow2" Height="0"/>
                                    <RowDefinition x:Name="EncoderOptionRow3" Height="0"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="EncoderOptionCol0" Width="*"/>
                                    <ColumnDefinition x:Name="EncoderOptionCol1" Width="*"/>
                                    <ColumnDefinition x:Name="EncoderOptionCol2" Width="*"/>
                                    <ColumnDefinition x:Name="EncoderOptionCol3" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="EncoderOptionFps" Grid.Column="0">
                                    <TextBlock Text="FPS da transmissão" Foreground="#8F9CA8" FontSize="9"/>
                                    <ComboBox x:Name="EncoderFpsComboBox" tips:LevelingInfoToolTip.Text="Define o FPS alvo usado neste teste/configuração do encoder. 60 FPS é recomendado para jogos quando a captura e a rede conseguem acompanhar." SelectedIndex="1" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                        <ComboBoxItem Content="30"/>
                                        <ComboBoxItem Content="60"/>
<ComboBoxItem Content="80"/>
<ComboBoxItem Content="90"/>
<ComboBoxItem Content="120"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="EncoderOptionBitrate" Grid.Column="1">
                                    <TextBlock Text="Bitrate de vídeo" Foreground="#8F9CA8" FontSize="9"/>
                                    <ComboBox x:Name="EncoderBitrateComboBox" tips:LevelingInfoToolTip.Text="Define o bitrate de vídeo do encoder. Mais bitrate melhora detalhes e reduz artefatos, mas aumenta o tráfego e a chance de congestionamento." SelectedIndex="5" HorizontalAlignment="Stretch" Margin="0,6,0,0">
                                        <ComboBoxItem Content="5 Mbps" Tag="5000"/>
                                        <ComboBoxItem Content="8 Mbps" Tag="8000"/>
