<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Multiverse.Services" x:Class="Multiverse.Views.HomePage" Background="{StaticResource DesignBackground}" UseLayoutRounding="True">
    <Page.Resources>
        <SolidColorBrush x:Key="Text" Color="#FFF4EF"/>
        <SolidColorBrush x:Key="Muted" Color="#B0BBC5"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DesignSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DesignGlassEdge}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#E62D4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E62D4F"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
        <LinearGradientBrush x:Key="DeviceCover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#33232B" Offset="0"/>
            <GradientStop Color="#10171D" Offset="0.55"/>
            <GradientStop Color="#721B32" Offset="1"/>
        </LinearGradientBrush>
        <DataTemplate x:Key="ComputerRowTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#26313A" CornerRadius="8" Height="38">
                        <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" Foreground="#AFBDCD"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding PresenceText}" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <Button ui:InterfaceMotion.Enabled="True" Grid.Column="2" Content="Conectar" Click="HomeFriendConnectButton_Click" IsEnabled="{Binding Online}" VerticalAlignment="Center" MinWidth="110"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ComputerGridTemplate">
            <Border Style="{StaticResource DesignCard}" Width="280" Margin="0,0,12,12">
                <StackPanel Spacing="12">
                    <Border Height="90" Background="{StaticResource DesignSurface}" CornerRadius="8">
                        <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28"/>
                    </Border>
                    <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PresenceText}" Style="{StaticResource Caption}"/>
                    <Button ui:InterfaceMotion.Enabled="True" Content="Conectar" Click="HomeFriendConnectButton_Click" IsEnabled="{Binding Online}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ComputerRowsPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ComputerGridPanel">
            <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
        </ItemsPanelTemplate>
    </Page.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1500"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchColumn.Width" Value="480"/>
                        <Setter Target="SearchControls.(Grid.Column)" Value="1"/>
                        <Setter Target="SearchControls.(Grid.Row)" Value="0"/>
                        <Setter Target="QuickPanel.Margin" Value="0"/>
                        <Setter Target="QuickColumn.Width" Value="0"/>
                        <Setter Target="QuickPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="QuickPanel.(Grid.Row)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchColumn.Width" Value="0"/>
                        <Setter Target="SearchControls.(Grid.Column)" Value="0"/>
                        <Setter Target="SearchControls.(Grid.Row)" Value="1"/>
                        <Setter Target="QuickPanel.Margin" Value="0"/>
                        <Setter Target="QuickColumn.Width" Value="0"/>
                        <Setter Target="QuickPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="QuickPanel.(Grid.Row)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="24,4,24,24" Spacing="20">
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="SearchColumn" Width="480"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="Computadores" Style="{StaticResource DesignTitle}" FontSize="26"/>
                        <TextBlock Text="Seu PC, pronto para compartilhar." Style="{StaticResource DesignSubtitle}"/>
                    </StackPanel>
                    <Grid x:Name="SearchControls" Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DeviceSearchBox" Height="40" PlaceholderText="Buscar computadores…" TextChanged="DeviceSearchBox_TextChanged"/>
                        <ComboBox x:Name="DeviceFilterCombo" Height="40" Grid.Column="1" SelectedIndex="0" SelectionChanged="DeviceFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Online"/>
                            <ComboBoxItem Content="Offline"/>
                        </ComboBox>
                        <Button Grid.Column="2" ui:InterfaceMotion.Enabled="True" Content="＋ Adicionar" Height="40" Padding="16,8" Click="AddComputerButton_Click" Style="{StaticResource DesignAction}"/>
                    </Grid>
                </Grid>
                <Grid ColumnSpacing="18" RowSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="QuickColumn" Width="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Background="{StaticResource DesignSurface}" CornerRadius="10" BorderThickness="0" MinHeight="156">
                        <Grid Padding="20">

                            <Grid x:Name="StudioLocalInfo" ColumnSpacing="24" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="ESTE COMPUTADOR" FontSize="10" CharacterSpacing="100" Foreground="#8F9CA8"/>
                                <TextBlock x:Name="LocalPcNameTextBlock" Text="Este PC" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display"/>
                                <TextBlock x:Name="LocalProfileText" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="LocalListenerStateTextBlock" Foreground="#20E49A" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TransmissionStateText" Style="{StaticResource Caption}"/>
                                </StackPanel><StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="SEU CÓDIGO" FontSize="10" Foreground="#8F9CA8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LocalMachineCodeTextBlock" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button ui:InterfaceMotion.Enabled="True" x:Name="CopyLocalCodeButton" Grid.Column="1" Click="CopyLocalCodeButton_Click" Padding="8" ToolTipService.ToolTip="Copiar código">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Button ui:InterfaceMotion.Enabled="True" x:Name="TransmissionButton" Content="Transmitir agora" Click="TransmissionButton_Click" Style="{StaticResource DesignAction}" HorizontalAlignment="Left" Padding="16,10" MinWidth="150"/>
                                <Button Content="Usar código" Padding="14,10" ToolTipService.ToolTip="Conectar a um computador por código">
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel x:Name="QuickPanel" Width="340">
                                                <Border Style="{StaticResource Card}" Padding="16">
                                                    <StackPanel Spacing="9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Conexão rápida" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Content="ⓘ" Padding="8,4" ToolTipService.ToolTip="Endereço deste computador">
                                                                <Button.Flyout>
                                                                    <Flyout>
                                                                        <StackPanel Spacing="8">
                                                                            <TextBlock x:Name="LocalTailscaleIpTextBlock" Style="{StaticResource Caption}"/>
                                                                            <TextBlock x:Name="LocalTailscaleInterfaceTextBlock" Style="{StaticResource Caption}"/>
                                                                            <TextBlock x:Name="LocalDirectEndpointTextBlock" Style="{StaticResource Caption}"/>
                                                                            <Button ui:InterfaceMotion.Enabled="True" x:Name="CopyDirectEndpointButton" Content="Copiar endpoint" Click="CopyDirectEndpointButton_Click"/>
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </Grid>
                                                        <TextBlock x:Name="TopStatusText" Visibility="Collapsed" Text="Verificando" Foreground="#E62D4F"/>
                                                        <TextBlock Text="Digite o código do computador autorizado." Style="{StaticResource Caption}"/>
                                                        <TextBox x:Name="ConnectCodeTextBox" Visibility="Collapsed"/>
                                                        <TextBox x:Name="ConnectCodeEntryTextBox" PlaceholderText="Código ou IP:porta#código"/>
                                                        <Button ui:InterfaceMotion.Enabled="True" x:Name="ConnectionButton" Content="Conectar" Click="ConnectButton_Click" HorizontalAlignment="Stretch" Padding="14,10"/>
                                                        <Button x:Name="OpenVideoButton" Content="Abrir vídeo" Click="OpenVideoButton_Click" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                                                        <TextBlock x:Name="VideoStartupStatusText" TextWrapping="Wrap" Foreground="#FF9BB8" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="ConnectionStateTextBlock" Style="{StaticResource Caption}"/>
                                                        <Border x:Name="ConnectFxBorder" Background="#3F1F2D" CornerRadius="8" Padding="8" Opacity="0" Visibility="Collapsed">
                                                            <TextBlock x:Name="ConnectionFeedbackText" Foreground="#FFA4B9" TextWrapping="Wrap"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        </Grid>
                    </Border>
</Grid>
                </Grid>
                                <ui:StudioQuickLinks/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HomeComputerCountText" Text="Seus computadores" Style="{StaticResource DesignSectionTitle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="ListViewButton" Click="ListViewButton_Click" ToolTipService.ToolTip="Exibir em lista">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="" FontSize="16"/>
                        </Button>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="GridViewButton" Click="GridViewButton_Click" ToolTipService.ToolTip="Exibir em grade">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="8">
                    <Border x:Name="LocalComputerCard" Style="{StaticResource DesignCard}" Background="{StaticResource DesignSurface}" BorderBrush="Transparent" BorderThickness="0" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="24"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="LocalRowNameText" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LocalRowStatusText" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <Button ui:InterfaceMotion.Enabled="True" x:Name="LocalRowTransmitButton" Grid.Column="2" Content="Transmitir" Click="TransmissionButton_Click" Style="{StaticResource DesignAction}"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="HomeOnlineFriendsList" ItemTemplate="{StaticResource ComputerRowTemplate}" ItemsPanel="{StaticResource ComputerRowsPanel}"/>
                    <Border x:Name="EmptyComputersCard" Style="{StaticResource Card}" MinHeight="110">
                        <StackPanel Spacing="16" VerticalAlignment="Center">
                            <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#778395"/>
                            <TextBlock x:Name="HomeNoOnlineFriendsText" Text="Seus outros computadores aparecem aqui." Foreground="{StaticResource Text}" FontSize="15" TextWrapping="Wrap"/>
                            <TextBlock Text="Adicione um computador em Amigos. Para redes diferentes, conecte os dois PCs ao Tailscale e autorize a comunicação." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Style="{StaticResource DesignCard}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Qualidade de vídeo" Style="{StaticResource DesignSectionTitle}" VerticalAlignment="Center"/>
                                <Button ui:InterfaceMotion.Enabled="True" Content="Configurar transmissão →" Click="OpenTransmissionButton_Click" Grid.Column="1" Padding="12,8"/>
                            </Grid>
                            <TextBlock x:Name="HomeSavedQualityText" Style="{StaticResource DesignSubtitle}"/>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DesignCard}" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Resolução" Style="{StaticResource Caption}"/>
                                        <ComboBox x:Name="HomeResolutionCombo" SelectionChanged="HomeQuality_SelectionChanged">
                                            <ComboBoxItem Content="720p" Tag="720p"/>
                                            <ComboBoxItem Content="1080p (Full HD)" Tag="1080p"/>
                                            <ComboBoxItem Content="1440p (QHD)" Tag="1440p"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource DesignCard}" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="FPS" Style="{StaticResource Caption}"/>
                                        <ComboBox x:Name="HomeFpsCombo" SelectionChanged="HomeQuality_SelectionChanged">
                                            <ComboBoxItem Content="30 FPS" Tag="30"/>
                                            <ComboBoxItem Content="60 FPS" Tag="60"/>
<ComboBoxItem Content="80 FPS" Tag="80"/>
<ComboBoxItem Content="90 FPS" Tag="90"/>
<ComboBoxItem Content="120 FPS" Tag="120"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DesignCard}" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Bitrate" Style="{StaticResource Caption}"/>
                                        <ComboBox x:Name="HomeBitrateCombo" SelectionChanged="HomeQuality_SelectionChanged">
                                            <ComboBoxItem Content="5 Mbps" Tag="5000"/>
                                            <ComboBoxItem Content="10 Mbps" Tag="10000"/>
                                            <ComboBoxItem Content="15 Mbps" Tag="15000"/>
                                            <ComboBoxItem Content="20 Mbps" Tag="20000"/>
                                            <ComboBoxItem Content="30 Mbps" Tag="30000"/>
                                            <ComboBoxItem Content="35 Mbps" Tag="35000"/>
                                            <ComboBoxItem Content="40 Mbps" Tag="40000"/>
                                            <ComboBoxItem Content="50 Mbps" Tag="50000"/>
                                            <ComboBoxItem Content="75 Mbps" Tag="75000"/>
                                            <ComboBoxItem Content="100 Mbps" Tag="100000"/>
                                            <ComboBoxItem Content="150 Mbps" Tag="150000"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
</Grid>
                    <StackPanel Grid.Column="1" Spacing="12">
                        <TextBlock Text="Sessões recentes" Style="{StaticResource DesignSectionTitle}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="RecentSessionText" Text="Nenhuma sessão recente" Foreground="{StaticResource Text}" FontSize="16"/>
                                <TextBlock x:Name="RecentSessionDetailText" Style="{StaticResource Caption}"/>
                                <Button ui:InterfaceMotion.Enabled="True" x:Name="ReconnectButton" Content="Reconectar" Click="ReconnectButton_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="LATÊNCIA" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="HomeLatencyValueTextBlock" Foreground="{StaticResource Text}" FontSize="20"/>
                            <TextBlock x:Name="HomeLatencyCaptionTextBlock" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="VÍDEO" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="HomeFpsValueTextBlock" Foreground="{StaticResource Text}" FontSize="20"/>
                            <TextBlock x:Name="HomeFpsCaptionTextBlock" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="BITRATE" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="HomeBitrateValueTextBlock" Foreground="{StaticResource Text}" FontSize="20"/>
                            <TextBlock x:Name="HomeBitrateCaptionTextBlock" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="5">
                            <TextBlock Text="CONEXÃO" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="HomeQualityValueTextBlock" Foreground="{StaticResource Text}" FontSize="20"/>
                            <TextBlock x:Name="HomeQualityCaptionTextBlock" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>