<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Multiverse.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tips="using:Multiverse.Services" xmlns:media="using:Microsoft.UI.Xaml.Media.Imaging" x:Class="Multiverse.Views.ControllerPage" Background="{StaticResource DesignBackground}" SizeChanged="ControllerPage_SizeChanged" KeyDown="ControllerPage_KeyDown" UseLayoutRounding="True">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DesignSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DesignGlassEdge}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="#1C252D"/>
            <Setter Property="Foreground" Value="#FFF4EF"/>
            <Setter Property="BorderBrush" Value="#34445A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Background" Value="#33232B"/>
            <Setter Property="Foreground" Value="#F55A7C"/>
            <Setter Property="BorderBrush" Value="#8E2744"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
        <Style x:Key="Danger" TargetType="Button">
            <Setter Property="Background" Value="#2A1319"/>
            <Setter Property="Foreground" Value="#FF6B82"/>
            <Setter Property="BorderBrush" Value="#7A2941"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E62D4F"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="70"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B9C2C9"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Subtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F9CA8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background" Value="#1C252D"/>
            <Setter Property="BorderBrush" Value="#2D3C51"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
    </Page.Resources>
    <Grid Background="{StaticResource DesignBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,4,24,24" HorizontalAlignment="Stretch" Spacing="16">
                <Border Background="Transparent" CornerRadius="0" MinHeight="72" BorderBrush="Transparent" BorderThickness="0">
                    <Grid Background="Transparent" Padding="0,8,0,12">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Margin="0" VerticalAlignment="Center" MaxWidth="430" HorizontalAlignment="Left">
                                <TextBlock Text="Controle" Foreground="#FFF4EF" FontSize="28" FontWeight="Bold" CharacterSpacing="0" FontFamily="Segoe UI Variable Display" TextWrapping="Wrap"/>
                                <TextBlock Text="Configure seu controle, permissões e resposta dos analógicos." Foreground="#8F9CA8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                
                            </StackPanel>
<StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="4" HorizontalAlignment="Left">
                                    <TextBlock Text="VISUAL DO CONTROLE" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="ControllerSkinComboBox" ui:LevelingInfoToolTip.Text="Troca apenas o visual e o layout exibido entre Xbox e PS5/DualSense. O host continua usando o controle virtual compatível configurado pelo Leveling." Width="172" SelectionChanged="ControllerSkinComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Xbox"/>
                                        <ComboBoxItem Content="PS5 / DualSense"/>
                                    </ComboBox>
                                </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <!-- Header -->
                <Grid x:Name="MainLayoutGrid" ColumnSpacing="14" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.28*"/>
                        <ColumnDefinition Width="1.0*"/>
                    </Grid.ColumnDefinitions>
                    <!-- LEFT: approved Xbox One visual -->
                    <Border x:Name="ControllerVisualCard" Style="{StaticResource Card}" BorderBrush="#8B2743">
                        <StackPanel Spacing="13">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="ControllerVisualModeTitleTextBlock" Text="XBOX 360 • INPUT LIVE" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="ControllerStatusTextBlock" Text="Aguardando sessão." Foreground="#C4CCD8" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ToggleSwitch x:Name="ControllerFeedbackToggle" Header="Feedback visual" IsOn="False" Toggled="ControllerFeedbackToggle_Toggled" OnContent="Ligado" OffContent="Desligado" VerticalAlignment="Center" FontSize="11"/>
                                    <Border VerticalAlignment="Center" Background="{StaticResource DesignSurface}" BorderBrush="#96314F" BorderThickness="0" CornerRadius="10" Padding="14,6">
                                        <TextBlock x:Name="ControllerRateTextBlock" Text="Xbox virtual" Foreground="#F55A7C" FontSize="11"/>
                                    </Border>
                                    <Button ui:InterfaceMotion.Enabled="True" x:Name="EditControllerLayoutButton" tips:LevelingInfoToolTip.Text="Abre o modo rápido para ajustar somente a posição e o tamanho das hitboxes dos analógicos. Use quando quiser alinhar os sticks sem editar o resto do controle." Content="Ajustar analógicos" Click="EditControllerLayoutButton_Click" Style="{StaticResource Primary}" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
                                    <Button ui:InterfaceMotion.Enabled="True" x:Name="EditFullControllerLayoutButton" tips:LevelingInfoToolTip.Text="Abre o editor completo do layout para mover e redimensionar outras hitboxes do controle mostrado na tela. Isso altera apenas a interface interativa do Leveling." Content="Editar controle" Click="EditFullControllerLayoutButton_Click" Style="{StaticResource Ghost}" Padding="12,6" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="ControllerLayoutEditorBar" Visibility="Collapsed" Background="{StaticResource DesignSurface}" BorderBrush="#721B32" BorderThickness="0" CornerRadius="12" Padding="12,10">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Coordinates and fine adjustments can scroll, but action buttons never leave the viewport. -->
                                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <StackPanel MinWidth="220" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock x:Name="LayoutEditorModeTitle" Text="AJUSTE DA HITBOX DOS ANALÓGICOS" Foreground="#E62D4F" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="LayoutSelectedElementText" Text="Clique em um analógico" Foreground="#FFF4EF" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="X" Foreground="#8F9CA8" VerticalAlignment="Center"/>
                                            <NumberBox x:Name="LayoutXNumberBox" tips:LevelingInfoToolTip.Text="Move horizontalmente a hitbox selecionada no editor. Altera apenas a posição visual/interativa do controle, não a transmissão." Width="92" SpinButtonPlacementMode="Compact" SmallChange="1" ValueChanged="LayoutNumberBox_ValueChanged"/>
                                            <TextBlock Text="Y" Foreground="#8F9CA8" VerticalAlignment="Center"/>
                                            <NumberBox x:Name="LayoutYNumberBox" tips:LevelingInfoToolTip.Text="Move verticalmente a hitbox selecionada no editor. Altera apenas a posição visual/interativa do controle, não a transmissão." Width="92" SpinButtonPlacementMode="Compact" SmallChange="1" ValueChanged="LayoutNumberBox_ValueChanged"/>
                                            <StackPanel x:Name="LayoutSizeControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                                <TextBlock Text="W" Foreground="#8F9CA8" VerticalAlignment="Center"/>
                                                <NumberBox x:Name="LayoutWidthNumberBox" tips:LevelingInfoToolTip.Text="Altera a largura da hitbox selecionada. Use para fazer a área clicável acompanhar exatamente o botão ou analógico da arte." Width="88" Minimum="20" SpinButtonPlacementMode="Compact" SmallChange="1" ValueChanged="LayoutNumberBox_ValueChanged"/>
                                                <TextBlock Text="H" Foreground="#8F9CA8" VerticalAlignment="Center"/>
                                                <NumberBox x:Name="LayoutHeightNumberBox" tips:LevelingInfoToolTip.Text="Altera a altura da hitbox selecionada. Use para fazer a área clicável acompanhar exatamente o botão ou analógico da arte." Width="88" Minimum="20" SpinButtonPlacementMode="Compact" SmallChange="1" ValueChanged="LayoutNumberBox_ValueChanged"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LayoutCoordinatesText" Text="X -- • Y -- • Centro X -- • Centro Y --" Foreground="#FF7F96" MinWidth="315" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Grid Grid.Row="1" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="LayoutEditorInstructionText" Text="Arraste o anel ou use as setas para mover 1 px." Foreground="#7F8B9A" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="2,0,12,0"/>
                                        <StackPanel x:Name="AnalogEditorActionPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button ui:InterfaceMotion.Enabled="True" x:Name="SaveAnalogAlignmentButton" tips:LevelingInfoToolTip.Text="Salva o alinhamento atual dos analógicos como novo padrão desta skin. As próximas vezes que você abrir o controle, essas posições serão usadas." Content="Salvar alinhamento" Click="SaveControllerLayoutButton_Click" Style="{StaticResource Primary}" MinWidth="138" Padding="14,8"/>
                                            <Button ui:InterfaceMotion.Enabled="True" x:Name="CancelAnalogAlignmentButton" tips:LevelingInfoToolTip.Text="Descarta as alterações do modo de ajuste dos analógicos e volta para o último layout salvo." Content="Cancelar" Click="CancelControllerLayoutButton_Click" Style="{StaticResource Ghost}" MinWidth="92" Padding="14,8"/>
                                            <Button ui:InterfaceMotion.Enabled="True" x:Name="ResetAnalogAlignmentButton" tips:LevelingInfoToolTip.Text="Restaura as posições padrão dos analógicos para a skin atual, desfazendo alinhamentos personalizados não salvos." Content="Restaurar padrão" Click="ResetControllerLayoutButton_Click" Style="{StaticResource Ghost}" MinWidth="138" Padding="14,8"/>
                                        </StackPanel>
                                        <StackPanel x:Name="FullEditorActionPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Visibility="Collapsed">
                                            <Button ui:InterfaceMotion.Enabled="True" x:Name="SaveFullLayoutButton" tips:LevelingInfoToolTip.Text="Salva o layout completo editado da skin atual, incluindo posições e tamanhos das hitboxes ajustadas no editor." Content="Salvar layout" Click="SaveControllerLayoutButton_Click" Style="{StaticResource Primary}" MinWidth="122" Padding="14,8"/>
                                            <Button ui:InterfaceMotion.Enabled="True" x:Name="CancelFullLayoutButton" tips:LevelingInfoToolTip.Text="Cancela a edição completa do controle e volta para o último layout salvo desta skin." Content="Cancelar" Click="CancelControllerLayoutButton_Click" Style="{StaticResource Ghost}" MinWidth="92" Padding="14,8"/>
                                            <Button ui:InterfaceMotion.Enabled="True" x:Name="ResetFullLayoutButton" tips:LevelingInfoToolTip.Text="Restaura o layout completo original da skin atual, removendo ajustes personalizados de posição e tamanho." Content="Restaurar padrão" Click="ResetControllerLayoutButton_Click" Style="{StaticResource Ghost}" MinWidth="138" Padding="14,8"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <!-- Shoulder controls intentionally live above the SVG, per the approved layout. -->
                            <Grid x:Name="ShoulderStrip" Margin="36,0,36,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="118"/>
                                    <ColumnDefinition Width="118"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="LtSurface" Grid.Column="0" Tag="LT" Tapped="ControllerPart_Tapped" ToolTipService.ToolTip="LT • deadzone e leitura em tempo real" Height="38" Background="{StaticResource DesignSurface}" BorderBrush="#8F2C4A" BorderThickness="1.4" CornerRadius="10">
                                    <Grid>
                                        <Border x:Name="LtFill" Width="0" HorizontalAlignment="Left" Background="#68EF2B56" CornerRadius="17"/>
