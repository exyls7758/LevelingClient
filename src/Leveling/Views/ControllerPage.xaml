                                                <TextBlock x:Name="RightOuterDeadzoneValue" Text="0%" Foreground="#8B82FF" HorizontalAlignment="Right" Width="42" TextAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="RightOuterDeadzoneSlider" Minimum="0" Maximum="20" StepFrequency="1" ValueChanged="RightOuterDeadzoneSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" tips:LevelingInfoToolTip.Text="Adiciona uma resposta mínima ao sair do centro do analógico esquerdo. Pode deixar movimentos iniciais mais rápidos, mas reduz a precisão fina.">
                                            <Grid>
                                                <TextBlock Text="Anti-deadzone L" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock x:Name="LeftAntiDeadzoneValue" Text="0%" Foreground="#E62D4F" HorizontalAlignment="Right" Width="42" TextAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="LeftAntiDeadzoneSlider" Minimum="0" Maximum="30" StepFrequency="1" ValueChanged="LeftAntiDeadzoneSlider_ValueChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" tips:LevelingInfoToolTip.Text="Adiciona uma resposta mínima ao sair do centro do analógico direito. Pode deixar movimentos iniciais mais rápidos, mas reduz a precisão fina.">
                                            <Grid>
                                                <TextBlock Text="Anti-deadzone R" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock x:Name="RightAntiDeadzoneValue" Text="0%" Foreground="#8B82FF" HorizontalAlignment="Right" Width="42" TextAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="RightAntiDeadzoneSlider" Minimum="0" Maximum="30" StepFrequency="1" ValueChanged="RightAntiDeadzoneSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" tips:LevelingInfoToolTip.Text="Ignora pequenas leituras iniciais do gatilho esquerdo. Útil quando o gatilho registra pressão sem estar realmente apertado.">
                                            <Grid>
                                                <TextBlock Text="Deadzone LT" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock x:Name="LeftTriggerDeadzoneValue" Text="0%" Foreground="#E62D4F" HorizontalAlignment="Right" Width="42" TextAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="LeftTriggerDeadzoneSlider" Minimum="0" Maximum="40" StepFrequency="1" ValueChanged="LeftTriggerDeadzoneSlider_ValueChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" tips:LevelingInfoToolTip.Text="Ignora pequenas leituras iniciais do gatilho direito. Útil quando o gatilho registra pressão sem estar realmente apertado.">
                                            <Grid>
                                                <TextBlock Text="Deadzone RT" Style="{StaticResource FieldLabel}"/>
                                                <TextBlock x:Name="RightTriggerDeadzoneValue" Text="0%" Foreground="#8B82FF" HorizontalAlignment="Right" Width="42" TextAlignment="Right"/>
                                            </Grid>
                                            <Slider x:Name="RightTriggerDeadzoneSlider" Minimum="0" Maximum="40" StepFrequency="1" ValueChanged="RightTriggerDeadzoneSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" tips:LevelingInfoToolTip.Text="Muda como o movimento físico dos analógicos vira resposta no jogo. Linear mantém 1:1; Precisão suaviza o centro; Rápida responde mais cedo.">
                                            <TextBlock Text="Curva dos analógicos" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="ResponseCurveComboBox" SelectedIndex="0" SelectionChanged="ResponseCurveComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Linear • 1:1"/>
                                                <ComboBoxItem Content="Precisão • centro suave"/>
                                                <ComboBoxItem Content="Rápida • resposta cedo"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <ToggleSwitch x:Name="InvertLeftYToggle" tips:LevelingInfoToolTip.Text="Inverte o eixo vertical do analógico esquerdo: empurrar para cima passa a gerar o valor que normalmente seria para baixo, e vice-versa." Grid.Column="1" Header="Inverter Y esquerdo" Toggled="InvertLeftYToggle_Toggled" VerticalAlignment="Bottom"/>
                                        <ToggleSwitch x:Name="InvertRightYToggle" tips:LevelingInfoToolTip.Text="Inverte o eixo vertical do analógico direito: empurrar para cima passa a gerar o valor que normalmente seria para baixo, e vice-versa." Grid.Column="2" Header="Inverter Y direito" Toggled="InvertRightYToggle_Toggled" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.25*"/>
                                </Grid.ColumnDefinitions>
                                <Button ui:InterfaceMotion.Enabled="True" x:Name="RebindButton" tips:LevelingInfoToolTip.Text="No host, recria o controle virtual Xbox 360. Use quando o jogo não reconheceu o dispositivo corretamente ou quando você precisa reinicializar o ViGEm." Content="↻  Recriar controle virtual" Style="{StaticResource Ghost}" Click="RebindButton_Click"/>
                                <Button ui:InterfaceMotion.Enabled="True" x:Name="NeutralizeButton" Grid.Column="1" tips:LevelingInfoToolTip.Text="No host, envia imediatamente um estado neutro para o controle virtual. Isso solta botões e analógicos caso algo tenha ficado preso." Content="◎  Neutralizar agora" Style="{StaticResource Ghost}" Click="NeutralizeButton_Click"/>
                                <Button ui:InterfaceMotion.Enabled="True" x:Name="ResetTuningButton" Grid.Column="2" tips:LevelingInfoToolTip.Text="Restaura o perfil original do controle para a skin atual, incluindo remapeamentos, deadzones, curvas e inversões salvos nesta aba." Content="↶  Restaurar perfil original do controle" Style="{StaticResource Primary}" Click="ResetTuningButton_Click"/>
                            </Grid>
                            <TextBlock Text="As alterações são salvas automaticamente. Transporte: latest-wins 250 Hz • UI: 20 Hz • watchdog: 250 ms." Foreground="#8F9CA8" FontSize="11" TextWrapping="Wrap"/>
                            <!-- Hidden compatibility controls: mapping is now contextual, opened from the controller itself. -->
                            <StackPanel Visibility="Collapsed">
                                <TextBlock x:Name="SelectedControlNameTextBlock"/>
                                <TextBlock x:Name="SelectedControlHintTextBlock"/>
                                <ComboBox x:Name="MappingTargetComboBox" SelectionChanged="MappingTargetComboBox_SelectionChanged"/>
                                <Button ui:InterfaceMotion.Enabled="True" x:Name="ResetSelectedMappingButton" Click="ResetSelectedMappingButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>