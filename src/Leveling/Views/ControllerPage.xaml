                                        <Border x:Name="YButtonOrb" Tag="Y" Tapped="ControllerPart_Tapped" ToolTipService.ToolTip="Y • clique para configurar o mapeamento" Width="144.859" Height="144.949" Canvas.Left="1481.054" Canvas.Top="172.439" Background="#00000000" BorderBrush="#00000000" BorderThickness="4.00" CornerRadius="72.5">
