                                        <TextBlock x:Name="LtLabelTextBlock" Text="LT" Foreground="#FFF4EF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="LbOrb" Grid.Column="1" Tag="LB" Tapped="ControllerPart_Tapped" ToolTipService.ToolTip="LB • clique para remapear" Height="38" Background="{StaticResource DesignSurface}" BorderBrush="#374659" BorderThickness="1.3" CornerRadius="10">
                                    <TextBlock x:Name="LbLabelTextBlock" Text="LB" Foreground="#C9D3CF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="RbOrb" Grid.Column="3" Tag="RB" Tapped="ControllerPart_Tapped" ToolTipService.ToolTip="RB • clique para remapear" Height="38" Background="{StaticResource DesignSurface}" BorderBrush="#374659" BorderThickness="1.3" CornerRadius="10">
                                    <TextBlock x:Name="RbLabelTextBlock" Text="RB" Foreground="#C9D3CF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="RtSurface" Grid.Column="4" Tag="RT" Tapped="ControllerPart_Tapped" ToolTipService.ToolTip="RT • deadzone e leitura em tempo real" Height="38" Background="#141928" BorderBrush="#5B4D86" BorderThickness="1.4" CornerRadius="10">
                                    <Grid>
                                        <Border x:Name="RtFill" Width="0" HorizontalAlignment="Left" Background="#686E66FF" CornerRadius="17"/>
                                        <Border x:Name="RtDeadzoneOverlay" Width="0" HorizontalAlignment="Left" Background="#74F3B260" CornerRadius="17,0,0,17"/>
                                        <TextBlock x:Name="RtLabelTextBlock" Text="RT" Foreground="#FFF4EF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
