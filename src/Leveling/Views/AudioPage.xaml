<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Multiverse.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tips="using:Multiverse.Services" x:Class="Multiverse.Views.AudioPage" UseLayoutRounding="True">
    <Page.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#10171D"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1C252D"/>
        <SolidColorBrush x:Key="CardBorder" Color="#303B45"/>
        <SolidColorBrush x:Key="Accent" Color="#E62D4F"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF4EF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#B0BBC5"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FFF4EF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
    </Page.Resources>
    <Grid Background="{StaticResource DesignBackground}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AudioResponsiveStates">
                <VisualState x:Name="AudioWide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1280"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AudioContent.Padding" Value="24,4,24,24"/>
                        <Setter Target="AudioMainCol0.Width" Value="*"/>
                        <Setter Target="AudioMainCol1.Width" Value="*"/>
                        <Setter Target="AudioMainRow1.Height" Value="0"/>
                        <Setter Target="ClientAudioPanel.(Grid.Row)" Value="0"/>
                        <Setter Target="ClientAudioPanel.(Grid.Column)" Value="1"/>
                        <Setter Target="ClientAudioPanel.Margin" Value="0"/>
                        <Setter Target="StopAudioButton.(Grid.Row)" Value="0"/>
                        <Setter Target="StopAudioButton.(Grid.Column)" Value="1"/>
                        <Setter Target="StopAudioButton.Margin" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AudioCompact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AudioContent.Padding" Value="24,4,24,24"/>
                        <Setter Target="AudioMainCol0.Width" Value="*"/>
                        <Setter Target="AudioMainCol1.Width" Value="0"/>
                        <Setter Target="AudioMainRow1.Height" Value="Auto"/>
                        <Setter Target="ClientAudioPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="ClientAudioPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="ClientAudioPanel.Margin" Value="0,18,0,0"/>
                        <Setter Target="StopAudioButton.(Grid.Row)" Value="1"/>
                        <Setter Target="StopAudioButton.(Grid.Column)" Value="0"/>
                        <Setter Target="StopAudioButton.Margin" Value="0,12,0,0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="AudioContent" Padding="24,4,24,24" Spacing="16">
                <Border Background="Transparent" CornerRadius="0" MinHeight="72" BorderBrush="Transparent" BorderThickness="0">
                    <Grid Background="Transparent" Padding="0,8,0,12">
                        <StackPanel Spacing="7" VerticalAlignment="Center" MaxWidth="460" HorizontalAlignment="Left">
                            <TextBlock Text="Áudio" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryText}" FontFamily="Segoe UI Variable Display" TextWrapping="Wrap"/>
                            <TextBlock Text="O som do jogo, do seu jeito." Foreground="{StaticResource SecondaryText}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Background="{StaticResource DesignSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0" CornerRadius="12" Padding="24">
                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="AudioMainCol0" Width="*"/>
                            <ColumnDefinition x:Name="AudioMainCol1" Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="AudioMainRow1" Height="0"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Column="0" Spacing="14">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DesignIconTile}">
                                    <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource DesignAccent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="ÁUDIO NO HOST" Style="{StaticResource DesignKicker}"/>
                                    <TextBlock Text="Aplicativo transmitido" Style="{StaticResource DesignSectionTitle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Escolha um aplicativo específico ou deixe o Leveling capturar automaticamente jogos e mídia, ignorando comunicação." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Modo de captura" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CaptureModeComboBox" tips:LevelingInfoToolTip.Text="Escolhe como o áudio do host é capturado. Aplicativo específico envia só o programa selecionado; Automático mistura jogos e mídia e ignora comunicação." SelectionChanged="CaptureModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Aplicativo específico" Tag="SpecificApplication"/>
                                    <ComboBoxItem Content="Automático — jogos e mídia" Tag="AutomaticGamesAndMedia"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="ManualAudioPanel" Spacing="10">
                                <ComboBox x:Name="ProcessComboBox" tips:LevelingInfoToolTip.Text="Escolhe qual aplicativo terá o áudio enviado quando o modo de captura estiver definido como Aplicativo específico." Header="Selecione um aplicativo" PlaceholderText="Selecione um aplicativo" SelectionChanged="ProcessComboBox_SelectionChanged"/>
                                <Button ui:InterfaceMotion.Enabled="True" Content="Atualizar lista" Click="RefreshProcessesButton_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel x:Name="AutomaticAudioPanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock Text="O Leveling mistura até 8 aplicativos com áudio ativo. Apps de comunicação são sempre bloqueados; se o Windows não conseguir verificar o uso do microfone, o áudio automático é pausado por segurança." Foreground="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                                <Border Background="#101A18" BorderBrush="#315D50" BorderThickness="0" CornerRadius="10" Padding="12,9">
                                    <StackPanel Spacing="3">
                                        <TextBlock x:Name="VoicePrivacyStatusText" Text="PRIVACIDADE DE VOZ • verificando..." Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="VoicePrivacyDetailText" Text="A proteção é aplicada apenas ao modo Automático." Foreground="{StaticResource SecondaryText}" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Expander Header="Aplicativos excluídos" IsExpanded="False">
                                    <StackPanel Spacing="9" Padding="0,8,0,2">
                                        <ListView x:Name="ExclusionsList" Height="128" SelectionMode="Single"/>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ExclusionExecutableTextBox" PlaceholderText="ex.: brave.exe"/>
                                            <Button ui:InterfaceMotion.Enabled="True" Grid.Column="1" Content="Adicionar" Click="AddExclusionButton_Click"/>
                                        </Grid>
                                        <Button ui:InterfaceMotion.Enabled="True" Content="Remover selecionado" Click="RemoveExclusionButton_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <Button ui:InterfaceMotion.Enabled="True" x:Name="HostAudioButton" Content="Iniciar áudio" Click="HostAudioButton_Click" Style="{StaticResource DesignAction}" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel x:Name="ClientAudioPanel" Grid.Column="1" Spacing="14">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource DesignIconTile}">
                                    <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource DesignAccent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                    <TextBlock Text="SAÍDA DO CLIENTE" Style="{StaticResource DesignKicker}"/>
                                    <TextBlock Text="Onde você escuta" Style="{StaticResource DesignSectionTitle}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Trocar a saída não reinicia vídeo, controle ou sessão remota." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                            <ComboBox x:Name="OutputDeviceComboBox" tips:LevelingInfoToolTip.Text="Escolhe em qual fone, caixa de som ou dispositivo do Windows o áudio remoto será reproduzido no cliente." Header="Dispositivo de saída" PlaceholderText="Padrão do Windows" SelectionChanged="OutputDeviceComboBox_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ResumeAudioButton" Content="Ouvir áudio" Click="ResumeAudioButton_Click" ui:InterfaceMotion.Enabled="True"/>
                                <Button Content="Atualizar saídas" Click="RefreshOutputsButton_Click" ui:InterfaceMotion.Enabled="True"/>
                            </StackPanel>
                            <TextBlock x:Name="ClientAudioHint" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                                <Slider x:Name="VolumeSlider" tips:LevelingInfoToolTip.Text="Ajusta somente o volume do áudio remoto no cliente. Não muda o volume do aplicativo no host nem a qualidade do áudio transmitido." Grid.Column="1" Minimum="0" Maximum="200" StepFrequency="5" ValueChanged="VolumeSlider_ValueChanged"/>
                                <TextBlock x:Name="VolumeValueText" Grid.Column="2" Foreground="{StaticResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
</Grid>
                <Border Background="{StaticResource DesignSurface}" BorderBrush="#303B45" BorderThickness="0" CornerRadius="10" Padding="18">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="STATUS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AudioStatusText" Text="Carregando áudio..." Foreground="{StaticResource PrimaryText}"/>
                            <TextBlock x:Name="AudioDetailText" Foreground="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button ui:InterfaceMotion.Enabled="True" x:Name="StopAudioButton" Grid.Column="1" Content="Parar áudio" Click="StopAllAudioButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
