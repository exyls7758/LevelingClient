<Page x:Class="Multiverse.Views.KeyboardMousePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Multiverse.Services" Background="{StaticResource DesignBackground}" UseLayoutRounding="True">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel x:Name="PageBody" Padding="24,4,24,24" Spacing="12" SizeChanged="PageSizeChanged">
 <StackPanel Spacing="4"><TextBlock Text="Teclado e mouse" Style="{StaticResource DesignTitle}"/><TextBlock Text="Seu jeito de jogar. Passe a vez sem trocar a sessão." Style="{StaticResource DesignSubtitle}"/></StackPanel>
 <Grid x:Name="ModeGrid" ColumnSpacing="12" RowSpacing="12">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource DesignCard}"><StackPanel Spacing="8"><TextBlock Text="Entrada na janela remota" FontWeight="SemiBold"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="ModeBox" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="ModeChanged" AutomationProperties.Name="Entrada do cliente"><ComboBoxItem Content="Pausada"/><ComboBoxItem Content="Controle"/><ComboBoxItem Content="Teclado e mouse"/></ComboBox>
   <Button Content="Jogar com teclado e mouse" Click="PlayClicked" ui:InterfaceMotion.Enabled="True"/>
   <Button Grid.Column="1" Content="Liberar agora" Click="ReleaseClicked" ui:InterfaceMotion.Enabled="True"/></Grid><Button Content="Usar controle" Click="GamepadClicked"/><TextBlock Text="Um clique abre o vídeo e ativa sua entrada. F8 é opcional." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource DesignMuted}"/></StackPanel></Border>
  <Border x:Name="HostCard" Grid.Column="1" Style="{StaticResource DesignCard}"><StackPanel Spacing="5"><TextBlock Text="Permissão deste PC" FontWeight="SemiBold"/><ToggleSwitch x:Name="HostToggle" OnContent="Teclado e mouse permitidos" OffContent="Teclado e mouse bloqueados" Toggled="HostChanged" AutomationProperties.Name="Permitir teclado e mouse do cliente autorizado"/><TextBlock Text="Permita aqui que seu convidado use teclado e mouse. Não depende da aba Controle." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource DesignMuted}"/></StackPanel></Border>
 </Grid>
 <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DesignMuted}"/>
 <Border Style="{StaticResource DesignCard}"><StackPanel Spacing="14">
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Mapa de teclas" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Escolha uma tecla ou botão do mouse e defina o que ele envia." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DesignMuted}"/></StackPanel><Button Grid.Column="1" Content="Restaurar padrão" Click="RestoreAll" ui:InterfaceMotion.Enabled="True"/></Grid>
  <Grid x:Name="DiagramGrid" ColumnSpacing="18" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="186"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="KeyboardRows" MinWidth="600" Spacing="5" VerticalAlignment="Center"/></ScrollViewer>
   <StackPanel x:Name="MouseDiagram" Grid.Column="1" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Viewbox Width="176" Height="264"><Canvas Width="320" Height="480"><Button x:Name="MouseLeft" Tag="1" Click="MouseSelected" Canvas.Left="62" Canvas.Top="55" Width="74" Height="130" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="12" BorderThickness="0" ToolTipService.ToolTip="Botão esquerdo" AutomationProperties.Name="Botão esquerdo" ui:InterfaceMotion.Enabled="True"/><Button x:Name="MouseRight" Tag="2" Click="MouseSelected" Canvas.Left="184" Canvas.Top="55" Width="74" Height="130" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="12" BorderThickness="0" ToolTipService.ToolTip="Botão direito" AutomationProperties.Name="Botão direito" ui:InterfaceMotion.Enabled="True"/><Button x:Name="MouseMiddle" Tag="3" Click="MouseSelected" Canvas.Left="143" Canvas.Top="68" Width="34" Height="74" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="12" BorderThickness="0" ToolTipService.ToolTip="Clique da roda" AutomationProperties.Name="Clique da roda" ui:InterfaceMotion.Enabled="True"/><Button x:Name="MouseSide1" Tag="4" Click="MouseSelected" Canvas.Left="29" Canvas.Top="190" Width="27" Height="48" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="12" BorderThickness="0" ToolTipService.ToolTip="Botão lateral X1" AutomationProperties.Name="Botão lateral X1" ui:InterfaceMotion.Enabled="True"/><Button x:Name="MouseSide2" Tag="5" Click="MouseSelected" Canvas.Left="26" Canvas.Top="248" Width="27" Height="52" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="12" BorderThickness="0" ToolTipService.ToolTip="Botão lateral X2" AutomationProperties.Name="Botão lateral X2" ui:InterfaceMotion.Enabled="True"/><Canvas IsHitTestVisible="False"><Path Data="M160 23 C132 23 101 28 77 39 C59 48 49 65 48 87 C47 126 48 163 49 199 C50 226 51 251 48 277 C46 299 39 315 40 336 C42 375 60 415 86 436 C105 452 129 460 160 460 C191 460 215 452 234 436 C260 415 278 375 280 336 C281 315 274 299 272 277 C269 251 270 226 271 199 C272 163 273 126 272 87 C271 65 261 48 243 39 C219 28 188 23 160 23 Z" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M49 177 L137 256 C141 260 145 261 151 261 L169 261 C175 261 179 260 183 256 L271 177" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M160 34 V68" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M160 142 V173" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M160 235 V261" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Rectangle Canvas.Left="145" Canvas.Top="68" Width="30" Height="74" RadiusX="11" RadiusY="11" Stroke="#B4BEC9" StrokeThickness="2.5"/><Rectangle Canvas.Left="149" Canvas.Top="73" Width="22" Height="65" RadiusX="8" RadiusY="8" Stroke="#B4BEC9" StrokeThickness="2.5"/><Path Data="M152 85 Q160 82 168 85 M152 90 Q160 87 168 90 M152 95 Q160 92 168 95 M152 100 Q160 97 168 100 M152 105 Q160 102 168 105 M152 110 Q160 107 168 110 M152 115 Q160 112 168 115 M152 120 Q160 117 168 120 M152 125 Q160 122 168 125 M153 130 Q160 127 167 130" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Rectangle Canvas.Left="154" Canvas.Top="173" Width="12" Height="62" RadiusX="6" RadiusY="6" Stroke="#B4BEC9" StrokeThickness="2.5"/><Path Data="M154 203 H166" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M48 190 C44 193 44 202 45 213 L47 241 L49.5 239" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M48 246 L43 247 C43 268 43 291 43 302 C47 288 49 267 48 246 Z" Stroke="#B4BEC9" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Canvas></Viewbox>
    <TextBlock Text="Roda · rolagem vertical" FontSize="11" Foreground="{StaticResource DesignMuted}" HorizontalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <Expander Header="Teclado numérico e tecla ISO / ABNT2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="ExtraKeys" Spacing="5" MinWidth="500"/></ScrollViewer></Expander>
  <Grid x:Name="MappingGrid" ColumnSpacing="14" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource DesignField}" CornerRadius="12" MinHeight="64"><TextBlock x:Name="SelectedBadge" Text="A" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="66"/></Border>
   <StackPanel Grid.Column="1" Spacing="6"><TextBlock x:Name="SelectedText" Text="A → A" FontSize="12" FontWeight="SemiBold"/><ComboBox x:Name="DestinationBox" HorizontalAlignment="Stretch" SelectionChanged="DestinationChanged" AutomationProperties.Name="Enviar como"/></StackPanel>
   <Button x:Name="RestoreKeyButton" Grid.Column="2" Content="Restaurar este botão" Click="RestoreSelected" VerticalAlignment="Bottom" ui:InterfaceMotion.Enabled="True"/>
  </Grid>
  <TextBlock Text="O teclado do host continua disponível. Vocês controlam a mesma entrada do Windows, um de cada vez." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource DesignMuted}"/>
 </StackPanel></Border>
 <Border Style="{StaticResource DesignCard}"><StackPanel Spacing="10">
  <TextBlock Text="Resposta e atalhos" FontSize="16" FontWeight="SemiBold"/>
  <TextBlock x:Name="SensitivityText" Text="Sensibilidade do mouse · 1,00×" FontSize="12"/><Slider x:Name="SensitivitySlider" Minimum="0.1" Maximum="3" StepFrequency="0.05" ValueChanged="SensitivityChanged" AutomationProperties.Name="Sensibilidade do mouse"/>
  <Grid x:Name="ShortcutGrid" ColumnSpacing="16" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ComboBox x:Name="CaptureKeyBox" Header="Capturar / liberar" HorizontalAlignment="Stretch" SelectionChanged="ShortcutChanged"/>
   <ComboBox x:Name="GamepadKeyBox" Grid.Column="1" Header="Voltar ao controle" HorizontalAlignment="Stretch" SelectionChanged="ShortcutChanged"/>
   <CheckBox x:Name="InvertBox" Grid.Column="2" Content="Inverter eixo Y" Checked="InvertChanged" Unchecked="InvertChanged" VerticalAlignment="Bottom"/>
  </Grid>
  <TextBlock Text="Use os atalhos na janela remota. Ctrl+Alt+Backspace sempre libera. Ao sair da janela ou perder a conexão, as teclas são soltas." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DesignMuted}"/>
  <TextBlock Text="A sensibilidade ajusta apenas o mouse enviado. A repetição de teclas depende do jogo. Alterar o mapa libera a entrada antes de salvar." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource DesignMuted}"/>
 </StackPanel></Border>
</StackPanel></ScrollViewer></Page>
