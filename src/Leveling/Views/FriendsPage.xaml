<?xml version='1.0' encoding='UTF-8'?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="using:Multiverse.Services" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Multiverse.Views.FriendsPage" Background="{StaticResource DesignBackground}" UseLayoutRounding="True">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DesignSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DesignGlassEdge}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DesignField}"/>
            <Setter Property="Foreground" Value="#B9C2C9"/>
            <Setter Property="BorderBrush" Value="#2D3A4D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="ui:InterfaceMotion.Enabled" Value="True"/>
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,4,24,24" HorizontalAlignment="Stretch" Spacing="16">
                <Border Background="Transparent" CornerRadius="0" MinHeight="72" BorderBrush="Transparent" BorderThickness="0">
                    <Grid Background="Transparent" Padding="0,8,0,12">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel MaxWidth="430" HorizontalAlignment="Left">
                                <TextBlock Text="Amigos" Foreground="#FFF4EF" FontSize="28" FontWeight="Bold" CharacterSpacing="0" FontFamily="Segoe UI Variable Display" TextWrapping="Wrap"/>
                                <TextBlock Text="Você decide quem entra." Foreground="#8F9CA8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
<Button ui:InterfaceMotion.Enabled="True" x:Name="RefreshFriendsButton" Content="Atualizar Tailscale" Style="{StaticResource Ghost}" VerticalAlignment="Center" Click="RefreshFriendsButton_Click" Grid.Column="1" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Border>
                <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Style="{StaticResource Card}" Background="{StaticResource DesignSurface}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="15" Background="{StaticResource DesignSurface}" BorderBrush="#303B45" BorderThickness="0">
                            <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" Foreground="#E62D4F" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="REDE E ACESSO" Foreground="#8F9CA8" FontSize="12"/>
                            <TextBlock x:Name="FriendsStatusTextBlock" Text="Atualizando peers..." Foreground="#E2E7EE" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="LocalIdentityTextBlock" Text="ID local" Foreground="#F45A79" FontSize="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
</Grid>
                <StackPanel Spacing="9">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="Pedidos pendentes" Style="{StaticResource DesignSectionTitle}"/>
                        <Border Background="#202B38" CornerRadius="14" Padding="10,3" BorderThickness="0">
                            <TextBlock x:Name="PendingCountText" Text="0"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="PendingRequestsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
<ui:CornerGlow AroundCard="True" Width="220" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-28,0"/>
<Border Style="{StaticResource Card}" Margin="0,0,0,8" Background="{StaticResource DesignSurface}" BorderBrush="#721B32">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#FFF4EF" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RemoteAddress}" Foreground="#8F9CA8" FontSize="13" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button ui:InterfaceMotion.Enabled="True" Grid.Column="1" Content="Recusar" Style="{StaticResource Ghost}" DataContext="{Binding}" Click="DeclineFriendButton_Click"/>
                                        <Button ui:InterfaceMotion.Enabled="True" Grid.Column="2" Content="Aceitar" Background="#E62D4F" Foreground="White" BorderThickness="0" CornerRadius="10" Padding="14,8" DataContext="{Binding}" Click="AcceptFriendButton_Click"/>
                                    </Grid>
                                </Border>
</Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="PendingEmptyCard" Style="{StaticResource DesignCard}" Padding="24">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#8F9CA8"/>
                            <TextBlock Text="Nenhum pedido pendente" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Quando alguém solicitar acesso a este computador, os pedidos aparecerão aqui." Style="{StaticResource DesignSubtitle}" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="9">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="Computadores autorizados" Style="{StaticResource DesignSectionTitle}"/>
                        <Border Background="#202B38" CornerRadius="14" Padding="10,3" BorderThickness="0">
                            <TextBlock x:Name="TrustedCountText" Text="0"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="TrustedFriendsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource DesignSurface}" BorderBrush="#303B45" BorderThickness="0">
                                            <Ellipse Width="8" Height="8" Fill="#E62D4F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#FFF4EF" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PresenceText}" ToolTipService.ToolTip="{Binding RouteText}" Foreground="#8F9CA8" FontSize="13" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button ui:InterfaceMotion.Enabled="True" Grid.Column="2" Content="⋯" Style="{StaticResource Ghost}" MinWidth="42" Padding="10,6" DataContext="{Binding}" ToolTipService.ToolTip="Permissões do amigo">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <ToggleMenuFlyoutItem Text="Permitir entrada direta" IsChecked="{Binding AllowDirectConnection}" DataContext="{Binding}" Click="DirectPermission_Click"/>
                                                    <ToggleMenuFlyoutItem Text="Aceitar automaticamente" IsChecked="{Binding AutoAcceptConnection}" IsEnabled="{Binding AllowDirectConnection}" DataContext="{Binding}" Click="AutoAcceptPermission_Click"/>
                                                    <ToggleMenuFlyoutItem Text="Permitir controle remoto" IsChecked="{Binding AllowRemoteInput}" DataContext="{Binding}" Click="InputPermission_Click"/>
                                                    <ToggleMenuFlyoutItem Text="Permitir áudio" IsChecked="{Binding AllowRemoteAudio}" DataContext="{Binding}" Click="AudioPermission_Click"/>
                                                    <MenuFlyoutSeparator/>
                                                    <ToggleMenuFlyoutItem Text="Bloquear" IsChecked="{Binding Blocked}" DataContext="{Binding}" Click="BlockPermission_Click"/>
                                                    <MenuFlyoutItem Text="Remover amigo" DataContext="{Binding}" Click="RemoveFriendButton_Click"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button ui:InterfaceMotion.Enabled="True" Grid.Column="3" Content="Conectar" IsEnabled="{Binding Online}" Background="#E62D4F" Foreground="White" BorderThickness="0" CornerRadius="10" Padding="16,8" FontWeight="SemiBold" DataContext="{Binding}" Click="ConnectFriendButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoFriendsTextBlock" Text="Nenhum amigo confiável ainda. Adicione um peer Tailscale abaixo." Foreground="#8F9CA8" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="9">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="Computadores na rede" Style="{StaticResource DesignSectionTitle}"/>
                        <Border Background="#202B38" CornerRadius="14" Padding="10,3" BorderThickness="0">
                            <TextBlock x:Name="PeersCountText" Text="0"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl x:Name="VisiblePeersList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Background="{StaticResource DesignSurface}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#FFF4EF" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TailscaleIp}" Foreground="#8F9CA8" FontSize="13" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding RouteText}" Foreground="#8F9CA8" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button ui:InterfaceMotion.Enabled="True" Grid.Column="1" Content="Adicionar amigo" Style="{StaticResource Ghost}" DataContext="{Binding}" Click="AddFriendButton_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="PeersEmptyCard" Style="{StaticResource DesignCard}" Padding="24">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#8F9CA8"/>
                            <TextBlock Text="Nenhum computador na rede" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Um peer da tailnet nunca recebe acesso só por existir. O Leveling exige aceite + identidade assinada." Style="{StaticResource DesignSubtitle}" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>