      <AdditionalDependencies>
        cuda.lib;
        nvcuvid.lib;
        delayimp.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <DelayLoadDLLs>
        nvcuvid.dll;
        %(DelayLoadDLLs)
      </DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>

