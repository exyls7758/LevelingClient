    <ProjectGuid>{2A61C4C4-CE2D-4A54-8EB1-91A4B69A71E2}</ProjectGuid>
    <RootNamespace>MultiverseCore</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <ProjectName>Multiverse.Core</ProjectName>
  </PropertyGroup>

  <!--
    Core 03 RAW:
    só depende do header oficial Interface\nvEncodeAPI.h.
    Não compila mais NvEncoder.cpp, NvEncoderD3D11.cpp, Logger.h, Utils.h etc.
  -->
  <PropertyGroup>
    <NvCodecSdkRoot Condition="'$(NV_CODEC_SDK)' != ''">$(NV_CODEC_SDK)</NvCodecSdkRoot>
    <CudaToolkitRoot Condition="'$(CUDA_PATH)' != ''">$(CUDA_PATH)</CudaToolkitRoot>
    <MultiverseNvencEnabled
      Condition="Exists('$(NvCodecSdkRoot)\Interface\nvEncodeAPI.h')">true</MultiverseNvencEnabled>
    <MultiverseNvencEnabled
      Condition="'$(MultiverseNvencEnabled)' == ''">false</MultiverseNvencEnabled>

    <MultiverseNvdecEnabled
      Condition="Exists('$(CudaToolkitRoot)\include\cuda.h') And
                 Exists('$(CudaToolkitRoot)\lib\x64\cuda.lib') And
                 Exists('$(NvCodecSdkRoot)\Interface\nvcuvid.h') And
                 Exists('$(NvCodecSdkRoot)\Interface\cuviddec.h') And
                 Exists('$(NvCodecSdkRoot)\Lib\win\x64\nvcuvid.lib')">true</MultiverseNvdecEnabled>
    <MultiverseNvdecEnabled
      Condition="'$(MultiverseNvdecEnabled)' == ''">false</MultiverseNvdecEnabled>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />

  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
